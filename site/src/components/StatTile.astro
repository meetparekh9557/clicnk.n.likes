---
// Stat tile: a single cited market figure. Value + label + source.
// The value is the loud element; the source keeps every claim honest
// and checkable (never a client result - see src/data/market.ts).
//
// The number counts up from zero when the tile scrolls into view. That is
// handled by CountUpValue, which animates every numeric run in the string,
// so ranges and mixed values are no longer skipped the way this component's
// own parser used to skip them.
import CountUpValue from './CountUpValue.astro';
interface Props { value: string; label: string; source: string; class?: string; style?: string; }
const { value, label, source, class: extra = '', style } = Astro.props;
---

<div class={`rounded-2xl border border-navy/10 bg-white p-6 shadow-[0_10px_30px_rgba(26,43,74,0.06)] ${extra}`.trim()} style={style}>
  <div class="font-display text-4xl font-bold text-teal-dark"><CountUpValue value={value} /></div>
  <p class="mt-2 text-sm leading-relaxed text-navy/70">{label}</p>
  <p class="mt-3 text-xs font-medium text-navy/45">Source: {source}</p>
</div>
