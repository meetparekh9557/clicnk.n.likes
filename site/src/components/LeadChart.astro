---
// Dual-channel lead chart for a case study. Pure inline SVG — no chart
// library, no client JS beyond a small IntersectionObserver that draws the
// lines in once they scroll into view (and skips the animation entirely
// under prefers-reduced-motion).
//
// Paid is the coral area, organic the teal one, stacked so the top edge is
// total monthly leads. The learning phase and the mid-engagement dip are
// deliberately visible: a curve that only goes up is the least believable
// thing a case study can show.
import type { LeadPoint } from '../data/caseStudies';

interface Props { leads: LeadPoint[]; id?: string; }
const { leads, id = 'leadchart' } = Astro.props;

const W = 760, H = 340;
const PAD = { t: 26, r: 18, b: 40, l: 46 };
const iw = W - PAD.l - PAD.r;
const ih = H - PAD.t - PAD.b;

const totals = leads.map((d) => d.paid + d.organic);
const maxY = Math.ceil(Math.max(...totals) / 50) * 50 + 50;
const x = (m: number) => PAD.l + ((m - 1) / (leads.length - 1)) * iw;
const y = (v: number) => PAD.t + ih - (v / maxY) * ih;

// Smooth-ish path through the points (monotone-flavoured cubic).
function path(vals: number[]) {
  const pts = vals.map((v, i) => [x(leads[i].m), y(v)] as const);
  let d = `M ${pts[0][0]},${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [px, py] = pts[i - 1], [cx, cy] = pts[i];
    const mx = (px + cx) / 2;
    d += ` C ${mx},${py} ${mx},${cy} ${cx},${cy}`;
  }
  return d;
}
const areaFrom = (vals: number[], base: number[]) => {
  const up = path(vals);
  const down = base
    .map((v, i) => [x(leads[i].m), y(v)] as const)
    .reverse()
    .map(([cx, cy], i) => (i === 0 ? `L ${cx},${cy}` : `L ${cx},${cy}`))
    .join(' ');
  return `${up} ${down} Z`;
};

const zeros = leads.map(() => 0);
const paidVals = leads.map((d) => d.paid);
const totalVals = totals;

const gridVals = Array.from({ length: 5 }, (_, i) => Math.round((maxY / 4) * i));
const notes = leads.filter((d) => d.note);
---

<figure class="not-prose my-2">
  <div class="overflow-x-auto">
    <svg
      id={id}
      class="cnl-leadchart block h-auto w-full min-w-[600px]"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`Monthly leads across the engagement, rising from ${totals[0]} in month 1 to ${totals[totals.length - 1]} in month ${leads.length}, split between paid campaigns and organic search.`}
    >
      <defs>
        <linearGradient id={`${id}-paid`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FF4757" stop-opacity="0.30" />
          <stop offset="100%" stop-color="#FF4757" stop-opacity="0.04" />
        </linearGradient>
        <linearGradient id={`${id}-org`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#4ECDC4" stop-opacity="0.42" />
          <stop offset="100%" stop-color="#4ECDC4" stop-opacity="0.08" />
        </linearGradient>
      </defs>

      <!-- grid + y labels -->
      {gridVals.map((v) => (
        <g>
          <line x1={PAD.l} x2={W - PAD.r} y1={y(v)} y2={y(v)} stroke="#1A2B4A" stroke-opacity="0.08" stroke-width="1" />
          <text x={PAD.l - 10} y={y(v) + 4} text-anchor="end" font-size="11" fill="#1A2B4A" fill-opacity="0.45" font-family="DM Sans, sans-serif">{v}</text>
        </g>
      ))}

      <!-- x labels -->
      {leads.map((d) => (
        <text x={x(d.m)} y={H - 16} text-anchor="middle" font-size="11" fill="#1A2B4A" fill-opacity="0.45" font-family="DM Sans, sans-serif">
          {d.m}
        </text>
      ))}
      <text x={PAD.l + iw / 2} y={H - 2} text-anchor="middle" font-size="10.5" fill="#1A2B4A" fill-opacity="0.4" font-family="DM Sans, sans-serif">
        Month of engagement
      </text>

      <!-- stacked areas: paid on the bottom, organic on top -->
      <path class="cnl-area" d={areaFrom(totalVals, paidVals)} fill={`url(#${id}-org)`} />
      <path class="cnl-area" d={areaFrom(paidVals, zeros)} fill={`url(#${id}-paid)`} />

      <!-- lines -->
      <path class="cnl-line" d={path(totalVals)} fill="none" stroke="#33A79F" stroke-width="2.5" stroke-linecap="round" />
      <path class="cnl-line" d={path(paidVals)} fill="none" stroke="#FF4757" stroke-width="2.5" stroke-linecap="round" />

      <!-- points -->
      {leads.map((d) => (
        <g>
          <circle class="cnl-dot" cx={x(d.m)} cy={y(d.paid + d.organic)} r="3.5" fill="#fff" stroke="#33A79F" stroke-width="2" />
          <circle class="cnl-dot" cx={x(d.m)} cy={y(d.paid)} r="3" fill="#fff" stroke="#FF4757" stroke-width="2" />
        </g>
      ))}

      <!-- end-of-series values: makes the split explicit, so the teal line
           is never misread as organic alone -->
      <g class="cnl-endlab">
        <text x={x(leads[leads.length-1].m) - 6} y={y(leads[leads.length-1].paid) + 16} text-anchor="end"
          font-size="12" font-weight="700" fill="#FF4757" font-family="DM Sans, sans-serif">{leads[leads.length-1].paid} paid</text>
        <text x={x(leads[leads.length-1].m) - 6} y={y(leads[leads.length-1].paid + leads[leads.length-1].organic) - 8} text-anchor="end"
          font-size="12" font-weight="700" fill="#2c8f88" font-family="DM Sans, sans-serif">+{leads[leads.length-1].organic} organic</text>
      </g>

      <!-- annotations -->
      {notes.map((d) => (
        <g class="cnl-note">
          <line x1={x(d.m)} x2={x(d.m)} y1={y(d.paid + d.organic) - 10} y2={PAD.t - 6} stroke="#1A2B4A" stroke-opacity="0.22" stroke-width="1" stroke-dasharray="3 3" />
          <text
            x={Math.min(Math.max(x(d.m), PAD.l + 40), W - PAD.r - 40)}
            y={PAD.t - 11}
            text-anchor="middle"
            font-size="10.5"
            font-weight="600"
            fill="#1A2B4A"
            fill-opacity="0.6"
            font-family="DM Sans, sans-serif"
          >{d.note}</text>
        </g>
      ))}
      <!-- hover targets: one column per month -->
      <g class="cnl-hit">
        {leads.map((d) => (
          <rect
            x={x(d.m) - (iw / (leads.length - 1)) / 2}
            y={PAD.t}
            width={iw / (leads.length - 1)}
            height={ih}
            fill="transparent"
            data-m={d.m}
            data-paid={d.paid}
            data-org={d.organic}
            data-px={x(d.m)}
            data-py={y(d.paid + d.organic)}
          />
        ))}
      </g>
      <line class="cnl-guide" x1="0" x2="0" y1={PAD.t} y2={PAD.t + ih} stroke="#1A2B4A" stroke-opacity="0.28" stroke-width="1" style="opacity:0" />
    </svg>
    <div class="cnl-tip" role="status" aria-live="polite"></div>
  </div>

  <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px] text-navy/60">
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-coral"></span> Paid campaigns</span>
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-teal"></span> Organic search, stacked on top</span>
    <span class="text-navy/45">The upper edge is total monthly leads; the teal band is organic’s share of it. Reported during the engagement. The flat opening is the ad-platform learning phase; the mid-engagement dip is shown as it happened.</span>
  </figcaption>
</figure>

<style>
  figure .overflow-x-auto { position: relative; }
  .cnl-tip {
    position: absolute; pointer-events: none; opacity: 0; transform: translate(-50%, -115%);
    background: #1A2B4A; color: #fff; border-radius: 10px; padding: 8px 11px;
    font-size: 12px; line-height: 1.45; white-space: nowrap; z-index: 5;
    box-shadow: 0 8px 22px rgba(26, 43, 74, 0.24); transition: opacity 140ms ease;
  }
  .cnl-tip b { font-weight: 700; }
  .cnl-tip .p { color: #ff8f99; }
  .cnl-tip .o { color: #7fe3db; }
  .cnl-hit rect { cursor: crosshair; }
  /* the guide follows the cursor, so it must never swallow the hover it
     is responding to */
  .cnl-guide { pointer-events: none; }
  .cnl-leadchart .cnl-endlab { opacity: 0; }
  .cnl-leadchart.in .cnl-endlab { animation: cnl-fade 600ms ease-out 1300ms forwards; }
  .cnl-leadchart .cnl-line { stroke-dasharray: 2400; stroke-dashoffset: 2400; }
  .cnl-leadchart .cnl-area,
  .cnl-leadchart .cnl-dot,
  .cnl-leadchart .cnl-note { opacity: 0; }
  .cnl-leadchart.in .cnl-line { animation: cnl-draw 1500ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .cnl-leadchart.in .cnl-area { animation: cnl-fade 900ms ease-out 500ms forwards; }
  .cnl-leadchart.in .cnl-dot { animation: cnl-fade 500ms ease-out 1100ms forwards; }
  .cnl-leadchart.in .cnl-note { animation: cnl-fade 600ms ease-out 1400ms forwards; }
  @keyframes cnl-draw { to { stroke-dashoffset: 0; } }
  @keyframes cnl-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .cnl-leadchart .cnl-line { stroke-dashoffset: 0; }
    .cnl-leadchart .cnl-area,
    .cnl-leadchart .cnl-dot,
    .cnl-leadchart .cnl-endlab,
    .cnl-leadchart .cnl-note { opacity: 1; }
    .cnl-leadchart.in .cnl-line,
    .cnl-leadchart.in .cnl-area,
    .cnl-leadchart.in .cnl-dot,
    .cnl-leadchart.in .cnl-note { animation: none; }
  }
</style>

<script>
  function initLeadCharts() {
    const charts = document.querySelectorAll('.cnl-leadchart');
    if (!charts.length) return;

    // Hover/focus readout. The teal line is the TOTAL, so the tooltip always
    // names the split explicitly rather than leaving it to be inferred.
    charts.forEach((svg) => {
      if (svg.dataset.hoverBound) return;
      svg.dataset.hoverBound = '1';
      const wrap = svg.parentElement;
      const tip = wrap && wrap.querySelector('.cnl-tip');
      const guide = svg.querySelector('.cnl-guide');
      if (!tip || !guide) return;
      const show = (r) => {
        const paid = +r.dataset.paid, org = +r.dataset.org;
        tip.innerHTML = '<b>Month ' + r.dataset.m + '</b><br>'
          + '<span class="p">\u25CF</span> Paid <b>' + paid + '</b><br>'
          + '<span class="o">\u25CF</span> Organic <b>+' + org + '</b><br>'
          + 'Total <b>' + (paid + org) + '</b>';
        const box = svg.getBoundingClientRect();
        const vb = svg.viewBox.baseVal;
        const sx = box.width / vb.width, sy = box.height / vb.height;
        // Clamp inside the wrapper so the tooltip never runs off an edge at
        // the first or last month.
        tip.style.opacity = '1';
        const half = tip.offsetWidth / 2;
        const raw = +r.dataset.px * sx;
        tip.style.left = Math.min(Math.max(raw, half + 4), box.width - half - 4) + 'px';
        tip.style.top = Math.max(+r.dataset.py * sy, tip.offsetHeight + 6) + 'px';
        guide.setAttribute('x1', r.dataset.px);
        guide.setAttribute('x2', r.dataset.px);
        guide.style.opacity = '1';
      };
      const hide = () => { tip.style.opacity = '0'; guide.style.opacity = '0'; };
      svg.querySelectorAll('.cnl-hit rect').forEach((r) => {
        r.addEventListener('mouseenter', () => show(r));
        r.addEventListener('focus', () => show(r));
        r.setAttribute('tabindex', '0');
      });
      svg.addEventListener('mouseleave', hide);
      svg.addEventListener('blur', hide, true);
    });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.25 });
    charts.forEach((c) => io.observe(c));
  }
  initLeadCharts();
  document.addEventListener('astro:page-load', initLeadCharts);
</script>
