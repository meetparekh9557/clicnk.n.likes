---
// Category filter for Insights and Work.
//
// Always open, one row, no toggle: the categories are navigation, and
// navigation that hides itself behind a click is navigation most readers
// never find. On narrow screens the row scrolls sideways rather than
// wrapping into three stacked lines that push the content off the fold.
//
// One category at a time. "All" is the default; picking a category replaces
// the selection rather than adding to it, and picking the selected one again
// returns to All. An item still belongs to several categories, so it appears
// under each of them — which is why the counts sum to more than the total.
interface Props {
  /** [category, count] pairs, already ordered. */
  categories: [string, number][];
  /** Total number of items, for the "All" chip. */
  total: number;
  /** Matches the data-filter-scope on the grid this controls. */
  scope: string;
  /** Accessible name for the group. Never rendered as visible text. */
  label?: string;
}
const { categories, total, scope, label = 'Filter by category' } = Astro.props;
---

<div class="cnl-filter" data-filter-for={scope}>
  <div class="cnl-filter-rail" role="group" aria-label={label}>
    <div class="cnl-filter-row">
      <button type="button" class="cnl-cat" data-cat="*" aria-pressed="true">
        All <span class="cnl-cat-n">{total}</span>
      </button>
      {categories.map(([name, n]) => (
        <button type="button" class="cnl-cat" data-cat={name} aria-pressed="false">
          {name} <span class="cnl-cat-n">{n}</span>
        </button>
      ))}
    </div>
  </div>

  <p class="cnl-filter-empty mt-5 hidden text-[15px] text-navy/60">
    Nothing in that category yet. <button type="button" class="cnl-filter-reset font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2">Show everything</button>.
  </p>
</div>

<style>
  /* One line on narrow screens, scrolled rather than wrapped; free to wrap
     once there is room for it. */
  .cnl-filter-rail {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin-inline: -5vw;
    padding-inline: 5vw;
  }
  .cnl-filter-rail::-webkit-scrollbar { display: none; }
  .cnl-filter-row {
    display: flex;
    gap: 8px;
    width: max-content;
    padding-block: 3px;
  }
  @media (min-width: 640px) {
    .cnl-filter-rail { overflow-x: visible; margin-inline: 0; padding-inline: 0; }
    .cnl-filter-row { flex-wrap: wrap; width: auto; }
  }

  .cnl-cat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: none;
    white-space: nowrap;
    border-radius: 999px;
    border: 1.5px solid rgba(26, 43, 74, 0.1);
    background: rgba(78, 205, 196, 0.06);
    padding: 8px 15px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(26, 43, 74, 0.72);
    transition: all 0.18s ease;
  }
  .cnl-cat:hover { border-color: #4ecdc4; }
  .cnl-cat:focus-visible { outline: 2px solid #4ecdc4; outline-offset: 2px; }
  .cnl-cat[aria-pressed='true'] { background: #33a79f; border-color: #33a79f; color: #fff; }
  .cnl-cat-n {
    font-size: 11.5px;
    font-weight: 700;
    opacity: 0.62;
    font-variant-numeric: tabular-nums;
  }

</style>

<!-- The filtered cards live in the PAGE, not in this component, so these rules
     must not be scoped: Astro would compile them to
     [data-astro-cid-…][data-filter-item].is-hidden, which matches nothing and
     silently leaves every card on screen. The keyframes travel with them,
     since scoped animation names get rewritten too. -->
<style is:global>
  [data-filter-item].is-hidden { display: none !important; }
  [data-filter-item].is-entering { animation: cnl-filter-in 260ms ease-out both; }
  @keyframes cnl-filter-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-filter-item].is-entering { animation: none; }
  }
</style>

<script>
  function initCategoryFilters() {
    document.querySelectorAll('.cnl-filter').forEach((root) => {
      if (root.dataset.filterBound) return;
      root.dataset.filterBound = '1';

      const scope = root.getAttribute('data-filter-for');
      const grid = document.querySelector(`[data-filter-scope="${scope}"]`);
      const chips = Array.from(root.querySelectorAll('.cnl-cat'));
      const empty = root.querySelector('.cnl-filter-empty');
      const reset = root.querySelector('.cnl-filter-reset');
      if (!grid) return;

      const items = Array.from(grid.querySelectorAll('[data-filter-item]'));
      // '*' means All. One category at a time, never a set.
      let active = '*';

      const apply = (animate) => {
        let shown = 0;
        items.forEach((el) => {
          const cats = (el.getAttribute('data-cats') || '').split('|').filter(Boolean);
          const match = active === '*' || cats.includes(active);
          const was = !el.classList.contains('is-hidden');
          el.classList.toggle('is-hidden', !match);
          el.classList.remove('is-entering');
          if (match && animate && !was) {
            // Restart the animation on cards that were hidden a moment ago.
            void el.offsetWidth;
            el.classList.add('is-entering');
          }
          if (match) shown++;
        });
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.getAttribute('data-cat') === active)));
        if (empty) empty.classList.toggle('hidden', shown !== 0);
      };

      chips.forEach((c) => {
        c.addEventListener('click', () => {
          const cat = c.getAttribute('data-cat');
          // Clicking the live category clears it rather than doing nothing.
          active = cat === active ? '*' : cat;
          apply(true);
        });
      });

      if (reset) reset.addEventListener('click', () => { active = '*'; apply(true); });

      apply(false);
    });
  }

  initCategoryFilters();
  document.addEventListener('astro:page-load', initCategoryFilters);
</script>
