---
// Custom 404: Astro emits this as /404.html, which GitHub Pages serves
// automatically (with a real 404 status) for any unmatched URL. Real Nav +
// Footer + chat button stay on (unlike the Thank You page's `bare` dead
// end) - a visitor who hits a bad link still needs real ways out. noindex
// so a stray crawl of a dead link never gets this page indexed.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { marketStats } from '../data/market';
import { articles } from '../data/articles';
import { caseStudies } from '../data/caseStudies';

// Real content, not category links - a lost visitor who scrolls past the
// scan/contact CTAs is browsing, so give them actual pieces to land on.
// Latest 2 posts (articles is newest-first) so this never goes stale as
// new posts get added; 2 real, named case studies (never a made-up one).
const latestPosts = articles.slice(0, 2).map((a) => ({ title: a.title, href: `/insights/${a.slug}/` }));
const featuredCaseStudies = ['aidbylaw', 'kopa-seamless']
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({ title: `${c.client} case study`, href: `/work/${c.slug}/` }));
const exploreLinks = [
  ...latestPosts,
  ...featuredCaseStudies,
  { title: 'Free Tools', href: '/tools/' },
  { title: 'Services', href: '/services/seo/' },
];

// Same sourced stat as the homepage hero's trust row - never a new number
// invented for this page.
const organicStat = marketStats.find((s) => s.source.includes('BrightEdge Research'))?.value ?? '';
---

<Base
  title="Page Not Found | Click.n.likes"
  description="The page you're looking for doesn't exist or has moved. Head back to the homepage, or explore SEO, content, social and website services from Click.n.likes."
  noindex
  hideCta
>
  <section class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-[5vw] py-20 text-center">
    <p class="reveal font-display text-[clamp(3.5rem,10vw,6rem)] leading-none font-bold text-teal" style="--d:0ms">
      404
    </p>
    <h1 class="reveal-mask mt-4 font-display text-[clamp(1.7rem,3.8vw,2.4rem)] leading-[1.15] font-bold text-navy">
      <span class="mask-line"><span>Even we can't rank a page that doesn't exist.</span></span>
    </h1>
    <p class="reveal mt-4 max-w-md text-lg leading-relaxed text-navy/70" style="--d:120ms">
      The page you're looking for doesn't exist or has moved. Here's how to get back on track.
    </p>
    <div class="reveal mt-8 flex flex-col items-center gap-4" style="--d:200ms">
      <Button href="/tools/" arrow magnetic>Still want to grow your traffic? Run a free scan</Button>
      <a href="/contact/" class="text-sm font-semibold text-navy/55 underline decoration-navy/20 underline-offset-4 transition-colors hover:text-teal-dark hover:decoration-teal-dark">
        Or talk to us directly
      </a>
    </div>
    <p class="reveal mt-8 text-sm font-semibold text-navy/50" style="--d:230ms">
      <span class="text-teal-dark">{organicStat}</span> of web traffic is organic search - the free scan shows you where yours stands.
    </p>
    <div class="reveal mt-10 w-full border-t border-navy/10 pt-8" style="--d:260ms">
      <nav class="mx-auto flex max-w-sm flex-col items-center gap-y-3" aria-label="Explore the site">
        {exploreLinks.map((l) => (
          <a href={l.href} class="text-sm font-medium text-navy/60 underline decoration-navy/15 underline-offset-4 transition-colors hover:text-teal-dark hover:decoration-teal-dark">
            {l.title}
          </a>
        ))}
      </nav>
    </div>
  </section>
</Base>
