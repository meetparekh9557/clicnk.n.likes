---
// One focused page per interactive tool. The tool island is the whole point
// of the page, so it hydrates on load; below it we cross-link the sibling
// tools and the flagship scan. Meta + breadcrumb per tool. Slugs come from
// the shared registry in data/tools.ts so the hub, nav and sitemap stay 1:1.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';
import SpeedCheck from '../../components/islands/SpeedCheck.jsx';
import SnapshotCheck from '../../components/islands/SnapshotCheck.jsx';
import FunnelRoiCalculator from '../../components/islands/FunnelRoiCalculator.jsx';
import CompetitorThreat from '../../components/islands/CompetitorThreat.jsx';
import SchemaWorkbench from '../../components/islands/SchemaWorkbench.jsx';
import GatedTool from '../../components/islands/GatedTool.jsx';
import IcpIntelligence from '../../components/islands/IcpIntelligence.jsx';
import { tools, toolPages, toolHref } from '../../data/tools';
import { toolConfigs } from '../../data/toolConfigs';
import { withBase } from '../../lib/url';
import { breadcrumbSchema } from '../../lib/seo';
import Gauge from '@lucide/astro/icons/gauge';
import Eye from '@lucide/astro/icons/eye';
import BarChart3 from '@lucide/astro/icons/chart-column-increasing';
import Target from '@lucide/astro/icons/target';
import Search from '@lucide/astro/icons/search';
import Code2 from '@lucide/astro/icons/code';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import FileSearch from '@lucide/astro/icons/file-search';
import UsersRound from '@lucide/astro/icons/users-round';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';

const ICONS = { Gauge, Eye, BarChart3, Target, Search, Code2, ShieldCheck, FileSearch, UsersRound };

export function getStaticPaths() {
  const meta = {
    'website-speed': {
      eyebrow: 'Live speed test',
      h1: 'How fast is your site, really?',
      lede: 'We load your live page the way a real visitor’s phone does and show you, in plain English, exactly what’s making people wait, and leave.',
      title: 'Free Website Speed Test & Core Web Vitals | Click.n.likes',
      description: 'Measure your website’s real mobile speed and Core Web Vitals live, explained in plain English, not jargon. Free, full report emailed, no call required.',
      body: {
        intro: 'Google now uses Core Web Vitals as a direct ranking signal, and a mobile visitor decides whether to stay within seconds of your page starting to load. This check loads your live page the way a phone on a real connection would, then reports the same three metrics Google’s own PageSpeed Insights and Search Console use to judge you, translated out of jargon and into what to fix first.',
        checks: [
          { label: 'Largest Contentful Paint (LCP)', text: 'How long the biggest visible element, usually your hero image or headline, takes to finish loading. Google’s threshold for "good" is 2.5 seconds or under.' },
          { label: 'Interaction to Next Paint (INP)', text: 'How responsive the page feels once someone actually taps or clicks something. Google’s threshold for "good" is 200 milliseconds or under.' },
          { label: 'Cumulative Layout Shift (CLS)', text: 'How much the page jumps around as it finishes loading, the reason people misclick buttons. Google’s threshold for "good" is 0.1 or under.' },
          { label: 'Mobile-first measurement', text: 'The test runs against the same conditions most of your visitors actually use, not a fast office connection.' },
        ],
        example: { metric: '53% of mobile visitors', text: 'abandon a page that takes longer than 3 seconds to load, per a Google/SOASTA Research study cited in Think with Google’s mobile speed report.' },
      },
    },
    'first-impression': {
      eyebrow: 'Live render',
      h1: 'The 3-second test, for real',
      lede: 'We render your live homepage above the fold and show you exactly what a first-time visitor sees before they scroll, or leave.',
      title: 'Free First-Impression Website Snapshot | Click.n.likes',
      description: 'See your live homepage above the fold, exactly as a first-time visitor does. A real render of the 3-second test. Free, no call required.',
      body: {
        intro: 'Research on first impressions puts the number in milliseconds, not minutes: a visitor forms an opinion about your website almost before they have read anything on it, based on layout, whitespace and visual hierarchy alone. This check renders your live homepage exactly as it appears above the fold, the first screen a visitor sees before they scroll or leave, so you can see what they are actually judging you on.',
        checks: [
          { label: 'Above-the-fold render', text: 'A real screenshot of your homepage as it loads, at the point a visitor decides to scroll or bounce, not a mockup or a guess.' },
          { label: 'Headline clarity', text: 'Whether what you do and who you do it for is stated plainly in the first screen, or buried under a slideshow.' },
          { label: 'Primary call-to-action visibility', text: 'Whether there is an obvious next step, call, quote or contact, without scrolling.' },
          { label: 'Visual clutter', text: 'Competing elements, stacked banners or unclear hierarchy that make a visitor work to understand the page.' },
        ],
        example: { metric: '50 milliseconds', text: 'is roughly how long it takes a user to form a first opinion of a website’s visual appeal, a finding from Lindgaard et al.’s peer-reviewed Carleton University study, published in Behaviour & Information Technology.' },
      },
    },
    'funnel-roi': {
      eyebrow: 'Calculator',
      h1: 'Funnel Leak & ROI Calculator',
      lede: 'Transparent scoring, no black box: your numbers against a healthy 3% conversion benchmark, live as you move the sliders.',
      title: 'Free Funnel Leak & ROI Calculator | Click.n.likes',
      description: 'See the exact revenue you leak versus a healthy 3% conversion rate, live as you move the sliders. Free, with a CRO checklist emailed.',
      body: {
        intro: 'Traffic without conversion is just a number on a dashboard. This calculator does not scan your live site, it takes the visitor and lead figures you already know and shows what you are leaving on the table against a healthy 3% visitor-to-lead conversion rate, the benchmark our own client funnels are built around, so the maths stays transparent and the result is entirely yours to check.',
        checks: [
          { label: 'Current conversion rate', text: 'Your leads divided by your visitors, calculated live as you type.' },
          { label: 'Revenue at your current rate vs. a healthy rate', text: 'The gap in leads, not just percentage points, converted into what that actually costs you.' },
          { label: 'No black box', text: 'Every number on screen comes from a fixed formula shown alongside it, never a hidden score.' },
          { label: 'Self-reported inputs, labelled honestly', text: 'This tool works from the numbers you enter; it does not independently verify your traffic or lead counts.' },
        ],
      },
    },
    'competitor-threat': {
      eyebrow: 'Quiz',
      h1: 'Competitor Threat Estimator',
      lede: 'Answer three questions about your main competitor. We score it with a fixed weighted matrix, no scraping, no guessing.',
      title: 'Free Competitor Threat Estimator | Click.n.likes',
      description: 'Score how much of a threat your main competitor really is, from a fixed weighted matrix. Free, honest, no scraping. Full breakdown emailed.',
      body: {
        intro: 'You already have a gut feeling about which competitor actually threatens you. This quiz replaces the gut feeling with a fixed, published weighted matrix: you answer three honest questions about their online presence and get a score built from public-facing signals, not from scraping their site or guessing at numbers we cannot see.',
        checks: [
          { label: 'Online visibility signals', text: 'How visible they are in the channels that matter for your category: search presence, review volume, social activity.' },
          { label: 'Weighted, not averaged', text: 'Each signal counts differently toward the final score, reflecting which factors correlate more with real competitive threat.' },
          { label: 'Self-reported inputs, labelled honestly', text: 'The score is only as accurate as the answers you give; we do not independently verify a competitor’s numbers.' },
          { label: 'No scraping, no guessing', text: 'We never pull data from a competitor’s site without their knowledge. Every input is something you already know or can look up in a minute.' },
        ],
        example: { metric: '98% of consumers', text: 'read online reviews for local businesses before deciding whether to trust them, per BrightLocal’s Local Consumer Review Survey, one of the signals this estimator weighs most heavily.' },
      },
    },
    'schema-generator': {
      eyebrow: 'Generator + Validator',
      h1: 'Schema Markup Generator & Checker',
      lede: 'Check what schema you already have, see exactly what is missing and why it matters, then generate it, pre-filled from your own page, no developer required.',
      title: 'Free Schema Markup Generator & Checker (JSON-LD) | Click.n.likes',
      description: 'Check your live schema against Google’s required properties, see the plain-English cost of every gap, and generate valid JSON-LD pre-filled from your own page. Free, no developer required.',
      body: {
        intro: 'Most schema tools make you choose: check what you have, or build what you need, in two separate places, re-typing your business details each time. This one does both in a single pass. Give us a URL and we read the schema already on that page, score it against Google Search Central’s own required and recommended properties, and tell you in plain English what each gap actually costs you, not just which property is missing. Then generate exactly what is missing, pre-filled from your own business details rather than a blank form.',
        checks: [
          { label: 'Real completeness score', text: 'A 0–100 score against Google’s own documented requirements, not a pass/fail guess.' },
          { label: 'Plain-English cost per gap', text: 'Not "missing: address" — "you are invisible in \'near me\' searches without it."' },
          { label: 'Pre-filled from your own page', text: 'Answer your business details once; every schema type reuses them automatically.' },
          { label: 'FAQ, HowTo, Product & more', text: 'The schema types most likely to earn a rich result or an AI citation for a specific question.' },
        ],
      },
    },
    'schema-validator': {
      eyebrow: 'Validator + Generator',
      h1: 'Schema Validator & Score',
      lede: 'Paste your JSON-LD or give us a URL. We score it against the exact required properties Google looks for, explain what each gap costs you, and can generate the fix.',
      title: 'Free Schema Markup Validator & Score | Click.n.likes',
      description: 'Validate your schema.org JSON-LD against Google’s required and recommended properties, see the plain-English cost of every gap, and generate what is missing. Free, no call required.',
      body: {
        intro: 'Most schema markup fails silently: the JSON-LD is present on the page but missing a property Google actually requires, so it never qualifies for the rich result it was meant to earn, and nothing in your browser tells you that happened. This checks your markup, or the live markup already on any URL you give us, against the specific required and recommended properties Google’s own documentation lists for that schema type, scores what is missing, and explains what the gap actually costs you, not just its name. Then generate the fix in the same place, pre-filled from your own page.',
        checks: [
          { label: 'Required vs. recommended', text: 'The fields Google states are mandatory for a rich result, separated from the ones that just improve it.' },
          { label: 'Live URL checking', text: 'Give us a URL and we read the markup actually shipping on your site right now, not what you think is there.' },
          { label: 'Plain-English cost, not raw errors', text: 'Every gap explained in terms of what you lose in search, not a wall of JSON.' },
          { label: 'Fix it in the same place', text: 'Generate exactly what is missing without starting over on a separate tool.' },
        ],
      },
    },
    'content-score': {
      eyebrow: 'Score',
      h1: 'Content SEO Score',
      lede: 'Paste one page of copy or its URL. We score that specific piece on the on-page fundamentals that actually move rankings.',
      title: 'Free Content SEO Score Checker | Click.n.likes',
      description: 'Score a single page of content on keyword placement, structure, readability, meta description and schema. Free, honest, full report emailed.',
      body: {
        intro: 'A page can be well-written and still lose in search, because ranking and AI-citation eligibility both depend on structural signals that have nothing to do with prose quality: where your target phrase sits, how the page is organized under headings, and whether a meta description exists at all. This tool scores one page of content, pasted in directly or pulled from its URL, on the on-page fundamentals search engines and AI systems actually parse.',
        checks: [
          { label: 'Keyword placement', text: 'Whether your primary topic appears in the places engines weight most: the title, the first paragraph and at least one heading.' },
          { label: 'Heading structure', text: 'Whether the page is organized under a logical H1/H2/H3 hierarchy an engine, or an AI summarizer, can follow, or is one unbroken wall of text.' },
          { label: 'Meta description', text: 'Whether one exists and sits within the roughly 155 to 160 characters search engines typically display before truncating it.' },
          { label: 'Schema presence', text: 'Whether the page carries any structured data at all, the same check the Schema Validator runs in full.' },
        ],
      },
    },
    'icp-intelligence': {
      eyebrow: 'Strategic diagnostic',
      h1: 'Find the customer segment you should actually be targeting',
      lede: 'Nine steps about how your business really works. We score real customer segments against your economics, your capacity and your objective, then show the working.',
      title: 'Free Ideal Customer Profile Tool | Click.n.likes',
      description: 'Answer 9 questions about your business and see which customer segment fits your goal, economics and capacity. Free, results not gated, no email required.',
      body: {
        intro: 'Most ICP exercises ask who you think your ideal customer is and then hand the answer back to you in a nicer format. That is a summary, not an analysis. This one asks about the things that decide the answer whether you like it or not: what a customer is worth to you in a year, what margin is left after you deliver, how long a sale takes, how many people you have to run it, how many more customers you could serve tomorrow, and what you are actually trying to achieve. It then scores real customer segments against those answers across 8 weighted dimensions and shows you every factor that moved the number.',
        checks: [
          { label: 'Your objective changes the answer', text: 'The same business chasing recurring revenue and the same business chasing a new export market get different recommendations, because the weighting genuinely changes. Your primary goal carries the most weight; secondary goals influence the result without ever overriding it.' },
          { label: 'Capacity and economics are treated as real constraints', text: 'A segment you cannot afford to win, or cannot deliver to once you have won it, scores down. An attractive customer you cannot serve is not an attractive customer.' },
          { label: 'It will disagree with you', text: 'Tell it who you think you should be targeting and it scores your business independently first. When your own numbers point somewhere else, it names the specific dimensions that disagree rather than agreeing to be polite.' },
          { label: 'Nothing is invented', text: 'Every figure comes from your answers or from arithmetic on them. The tool holds no industry benchmarks and no market data, so it makes no claims that would need them. Anything it had to assume is listed in the report.' },
          { label: 'A low-fit profile, not just a target', text: 'Knowing which customers to stop chasing is usually worth more than another persona, so the report names the segment your inputs argue against and explains why.' },
        ],
      },
      faqs: [
        { q: 'What is an ideal customer profile?', a: 'An ideal customer profile describes the type of customer your business is best placed to win, serve and keep profitably. It is a description of an organisation or a kind of buyer, not of one individual, and it is grounded in your economics and capacity rather than in who you would most enjoy working with.' },
        { q: 'How is an ICP different from a buyer persona?', a: 'The ICP is the kind of customer worth targeting; the persona is the human being inside it who actually makes the decision. You need both, and in that order. This tool produces the ICP first, then the buyer profile that sits inside it, because deciding what a 42-year-old operations manager cares about is pointless if that company was never a good fit to begin with.' },
        { q: 'Does this tool use AI?', a: 'No. The analysis is a deterministic scoring engine: fixed rules, published weights, the same answers always producing the same result. That is a deliberate choice rather than a limitation. A rules engine can show you exactly why it reached a conclusion, which a language model cannot, and this tool is only useful if you can check its reasoning.' },
        { q: 'How does the alignment score work?', a: 'Each segment is scored 0 to 100 across 8 dimensions: deal-size fit, capacity to sell and serve, goal alignment, acquisition feasibility, market and geography, fit with your current customers, repeat value and buying rhythm. Those are combined using weights set by your primary goal. It is an alignment score, not a probability: it says how well a segment matches your business, and it makes no claim about how likely anyone is to buy.' },
        { q: 'What happens if I do not know my customer data?', a: 'Skip the question. A missing answer is dropped from the weighting rather than scored as zero, so not tracking your churn rate never counts against you. The report tells you which signals were available, which were not, and what its confidence is as a result. Guessing at a number to fill a box would produce a worse answer than leaving it blank.' },
        { q: 'Does it work for ecommerce and consumer businesses, or only B2B?', a: 'Both. The questionnaire changes based on your business model: a B2B business is asked about company size, who signs off and procurement, while a consumer business is asked about life stage, price sensitivity and purchase frequency. Consumer businesses are scored against consumer segments and never shown an enterprise recommendation.' },
        { q: 'Can I use it if my business has no customers yet?', a: 'Yes, and the analysis handles it explicitly. With no customer base to learn from, the engine reasons from your product, pricing, capacity, market and objective instead, excludes the customer-evidence dimension entirely, and reports lower confidence. That is more honest than inferring a customer base that does not exist.' },
        { q: 'How does my business goal change the recommendation?', a: 'Substantially, which is the point. Chasing lower acquisition cost makes reachability and existing-customer fit count for more and deal size count for less. Chasing enterprise customers makes deal size and sales capacity dominate. Entering a new country almost eliminates any segment defined by being near you. Change the goal and re-run it: the answer should move, and if it does not, that itself tells you something.' },
        { q: 'Can it tell me which customers to avoid?', a: 'It produces a low-fit customer profile: the segment your inputs argue against, with the specific reasons, whether that is an economic mismatch, a capacity problem, or an acquisition cost your margin cannot fund. It is framed as a reading of what you told us rather than as a rule, because a segment that is wrong for your business today can become right when your pricing or capacity changes.' },
        { q: 'Can I use the results for advertising, SEO and sales?', a: 'That is what the second half of the report is for. It names the acquisition channels that suit this buyer and explains why each one, withholds channels your stated budget cannot sustain rather than listing them anyway, sets out the pain to lead with and the objections to answer, and turns the segment into content themes by buying stage.' },
      ],
    },
  };
  return toolPages.map((t) => ({ params: { tool: t.slug }, props: { tool: t, meta: meta[t.slug] } }));
}

const { tool, meta } = Astro.props;
const others = tools.filter((t) => t.slug !== tool.slug);
const trail: [string, string][] = [['Home', '/'], ['Free Tools', '/tools/'], [tool.name, toolHref(tool)]];
const jsonLd: unknown[] = [breadcrumbSchema(trail)];
if (meta.faqs?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: meta.faqs.map((f: { q: string; a: string }) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const iconWrap = 'mb-4 grid h-11 w-11 place-items-center rounded-xl bg-teal/10 text-teal-dark';
---

<Base title={meta.title} description={meta.description} jsonLd={jsonLd} hideCta>
  <Breadcrumbs trail={trail} />
  <section class="mx-auto max-w-5xl px-[5vw] pt-14 pb-8 text-center lg:pt-20">
    <a href={withBase('/tools/')} class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-teal-dark transition-colors hover:text-navy">
      <ArrowLeft size={15} stroke-width={2.5} aria-hidden="true" /> All free tools
    </a>
    <p class="reveal mt-5 text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">{meta.eyebrow}</p>
    <h1 class="reveal mt-3 font-display text-[clamp(2rem,4.2vw,3rem)] leading-[1.08] font-bold text-navy">{meta.h1}</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-navy/70" style="--d:120ms">{meta.lede}</p>
  </section>

  <section class="mx-auto max-w-5xl px-[5vw] pb-16">
    <div class="reveal">
      {tool.slug === 'website-speed' && <SpeedCheck client:load toolsHref={withBase('/tools/')} />}
      {tool.slug === 'first-impression' && <SnapshotCheck client:load toolsHref={withBase('/tools/')} />}
      {tool.slug === 'funnel-roi' && <FunnelRoiCalculator client:load />}
      {tool.slug === 'competitor-threat' && <CompetitorThreat client:load />}
      {(tool.slug === 'schema-generator' || tool.slug === 'schema-validator') && <SchemaWorkbench client:load />}
      {tool.slug === 'content-score' && <GatedTool config={toolConfigs.contentscore} serviceLabel="Content SEO Score" client:load />}
      {tool.slug === 'icp-intelligence' && <IcpIntelligence client:load />}
    </div>
  </section>

  <!-- Real explanatory content: what the check measures and why it matters -->
  {meta.body && (
    <section class="mx-auto max-w-5xl px-[5vw] pb-16">
      <div class="reveal rounded-2xl border border-navy/10 bg-off/60 p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-navy">What this check actually measures</h2>
        <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-navy/70">{meta.body.intro}</p>
        <ul class="mt-5 space-y-3">
          {meta.body.checks.map((c) => (
            <li class="text-[14.5px] leading-relaxed text-navy/70">
              <b class="font-semibold text-navy">{c.label}:</b> {c.text}
            </li>
          ))}
        </ul>
        {meta.body.example && (
          <div class="mt-6 rounded-xl border border-teal/30 bg-white p-5">
            <p class="text-xs font-semibold tracking-[0.14em] text-teal-dark uppercase">Example in Action</p>
            <p class="mt-2 text-[15px] leading-relaxed text-navy/80">
              <b class="font-semibold text-navy">{meta.body.example.metric}</b> {meta.body.example.text}
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FAQ: real questions people search, also emitted as FAQPage schema -->
  {meta.faqs?.length && (
    <section class="mx-auto max-w-5xl px-[5vw] pb-16">
      <h2 class="reveal font-display text-[clamp(1.4rem,2.6vw,2rem)] leading-[1.15] font-bold text-navy">
        Frequently asked questions
      </h2>
      <div class="reveal mt-6 border-t border-navy/10">
        {meta.faqs.map((f) => (
          <details class="group border-b border-navy/10 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[16px] leading-snug font-semibold text-navy [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/10 text-lg leading-none text-teal-dark transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[15px] leading-relaxed text-navy/70">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- Cross-links: keep people inside the free-tools suite -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <h2 class="reveal font-display text-[clamp(1.4rem,2.6vw,2rem)] leading-[1.15] font-bold text-navy">More free tools</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((t, i) => {
          const Icon = ICONS[t.icon] ?? Search;
          return (
            <Card href={toolHref(t)} class="reveal group" style={`--d:${(i % 4) * 80}ms`}>
              <span class="absolute top-6 right-6 text-navy/20 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal-dark">
                <ArrowUpRight size={17} stroke-width={2.5} aria-hidden="true" />
              </span>
              <div class={iconWrap}><Icon size={22} stroke-width={2} aria-hidden="true" /></div>
              <h3 class="font-display text-base font-semibold text-navy">{t.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy/60">{t.tagline}</p>
            </Card>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
