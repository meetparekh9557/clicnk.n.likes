---
// Article template. Bodies are first-party HTML ported verbatim from
// v1 (data/articles.ts) with root-relative internal links, rebased
// through withBase() so they work at / and /preview/.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InlineCta from '../../components/InlineCta.astro';
import RelatedReading from '../../components/RelatedReading.astro';
import { articles } from '../../data/articles';
import { serviceDetails, categoryToServiceSlug } from '../../data/services';
import { withBase } from '../../lib/url';
import { abs, articleSchema, breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const body = article.body.replace(/href="(\/[^"]*)"/g, (_m, p) => `href="${withBase(p)}"`);
const articlePath = `/insights/${article.slug}/`;
const featuredPath = `/insights/${article.slug}.png`;

// Auto-generated table of contents: every h2/h3 in the body gets a stable
// id and a TOC entry, so the on-page nav can never drift out of sync with
// the actual headings the way a hand-maintained list eventually would.
function extractToc(html: string) {
  const toc: { id: string; text: string; level: number }[] = [];
  const used = new Set<string>();
  const withIds = html.replace(/<h([23])>(.*?)<\/h\1>/g, (_m, level, text) => {
    const plain = text.replace(/<[^>]+>/g, '');
    let id = plain.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    if (used.has(id)) {
      let i = 2;
      while (used.has(`${id}-${i}`)) i++;
      id = `${id}-${i}`;
    }
    used.add(id);
    toc.push({ id, text: plain, level: Number(level) });
    return `<h${level} id="${id}">${text}</h${level}>`;
  });
  return { toc, html: withIds };
}
const { toc, html: bodyWithIds } = extractToc(body);

// SEO meta per article, written in the founder's voice (the on-page
// headline stays as-is). Titles in Title Case, descriptions ~155ch.
// Numbers are always written as numerals ("5 Profile Mistakes", "3-Second
// Test"), never spelled out: digits catch the eye in a search result and
// cost fewer characters.
const articleMeta: Record<string, { title: string; description: string }> = {
  'ai-search': {
    title: 'Why ChatGPT, Not Google, Now Decides Who Gets Found | Click.n.likes',
    description: 'AI answers name 2 or 3 businesses, then stop. Here is how to structure your headings, facts and schema so the engines quote you when your customer asks, not your competitor.',
  },
  'gbp-mistakes': {
    title: '5 Profile Mistakes Losing You the Local Pack | Click.n.likes',
    description: "The businesses missing from the map pack usually aren't worse, they are just making a handful of profile mistakes. Here are the 5 we find most often, and how to fix each one.",
  },
  'blog-that-ranks': {
    title: 'How to Write 1 Blog Post That Actually Ranks | Click.n.likes',
    description: "Most business blogs fail twice: they don't rank, and when they are read, they don't convert. Here is the structure we use so a single post does both, for humans and AI alike.",
  },
  '3-second-test': {
    title: 'The 3-Second Test Your Website Keeps Failing | Click.n.likes',
    description: 'A first-time visitor gives your site about 3 seconds. Here is the test we run before touching a line of code, and the 4 quiet leaks that cost you bookings.',
  },
};
const meta = articleMeta[article.slug] ?? { title: `${article.title} | Click.n.likes Insights`, description: article.excerpt };
const trail: [string, string][] = [
  ['Home', '/'],
  ['Insights', '/insights/'],
  [article.title, articlePath],
];
const jsonLd = [
  articleSchema({
    title: article.title,
    description: article.excerpt,
    path: articlePath,
    author: article.author,
    datePublished: article.date,
  }),
  breadcrumbSchema(trail),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
const displayDate = new Date(article.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

// Split the article at a paragraph boundary near the middle so a CTA can
// sit inside the read, not only at the top and bottom. Cutting only at
// </p> keeps every block intact.
const paras = bodyWithIds.split('</p>');
const canSplit = paras.length >= 5;
const mid = Math.ceil(paras.length / 2);
const bodyTop = canSplit ? paras.slice(0, mid).join('</p>') + '</p>' : bodyWithIds;
const bodyRest = canSplit ? paras.slice(mid).join('</p>') : '';

// Internal-linking audit (task #11): every article now links to sibling
// articles that share a category, and to the service page(s) its topic
// maps to - so authority flows both sideways (article to article) and
// down (article to the page that sells).
const relatedArticles = articles
  .filter((a) => a.slug !== article.slug && a.categories.some((c) => article.categories.includes(c)))
  .slice(0, 3)
  .map((a) => ({ kicker: a.tag, title: a.title, text: a.excerpt, href: `/insights/${a.slug}/` }));
const relatedServiceSlugsForArticle = [...new Set(article.categories.map((c) => categoryToServiceSlug[c]).filter(Boolean))];
const relatedServices = relatedServiceSlugsForArticle
  .map((slug) => serviceDetails.find((s) => s.slug === slug))
  .filter((s): s is (typeof serviceDetails)[number] => Boolean(s))
  .map((s) => ({ title: s.title, text: s.lead, href: `/services/${s.slug}/` }));
---

<Base title={meta.title} description={meta.description} ogType="article" ogImage={abs(featuredPath)} jsonLd={jsonLd}>
  <Breadcrumbs trail={trail} />
  <section class="mx-auto max-w-6xl px-[5vw] pt-14 pb-6 lg:pt-18">
    <a href={withBase('/insights/')} class="reveal text-sm font-semibold text-navy/55 transition-colors hover:text-teal-dark">← All insights</a>
    <p class="reveal mt-5 inline-flex items-center gap-2 rounded-full border border-teal/30 bg-teal/5 px-4 py-1.5 text-[13px] font-semibold text-navy" style="--d:60ms">
      <span class="h-1.5 w-1.5 rounded-full bg-teal"></span> {article.tag}
    </p>
    <h1 class="reveal-mask mt-4 max-w-3xl font-display text-[clamp(1.9rem,3.8vw,2.8rem)] leading-[1.12] font-bold text-navy">
      <span class="mask-line"><span>{article.title}</span></span>
    </h1>
    <p class="reveal mt-4 text-sm text-navy/55" style="--d:140ms">
      {article.author} · <time datetime={article.date}>{displayDate}</time> · {article.readTime}
    </p>
  </section>

  <div class="mx-auto max-w-6xl px-[5vw]">
    <div class="lg:grid lg:grid-cols-[1fr_260px] lg:gap-12">
      <!-- Main content column: image, TOC (mobile only), body, FAQ -->
      <div class="min-w-0">
        <img
          src={withBase(featuredPath)}
          width="1200"
          height="630"
          alt={article.title}
          class="reveal w-full rounded-2xl border border-navy/10 shadow-[0_18px_44px_rgba(26,43,74,0.10)]"
          style="--d:180ms"
        />

        {toc.length > 0 && (
          <nav class="reveal mt-8 rounded-2xl border border-navy/10 bg-off/60 p-5 lg:hidden" aria-label="Table of contents" style="--d:220ms">
            <p class="text-xs font-semibold tracking-[0.12em] text-navy/50 uppercase">On this page</p>
            <ul class="mt-3 space-y-2 text-[14.5px]">
              {toc.map((item) => (
                <li class={item.level === 3 ? 'pl-4' : ''}>
                  <a href={`#${item.id}`} class="text-navy/70 transition-colors hover:text-teal-dark">{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="pt-10 pb-12">
          <div class="article-body reveal" style="--d:200ms" set:html={bodyTop} />
          {canSplit && (
            <div class="my-10">
              <InlineCta
                eyebrow={`More on ${article.tag}?`}
                title="We do this for clients every day. Want it done for you?"
                primaryLabel="Get your instant quote"
                secondaryLabel="Scan my site free"
              />
            </div>
          )}
          {canSplit && <div class="article-body" set:html={bodyRest} />}
        </div>

        <!-- FAQs (also emitted as FAQPage structured data above) -->
        <section class="pb-20">
          <h2 class="font-display text-[clamp(1.5rem,2.6vw,2.1rem)] leading-[1.15] font-bold text-navy">
            Frequently asked questions
          </h2>
          <div class="mt-6 border-t border-navy/10">
            {article.faqs.map((f) => (
              <details class="group border-b border-navy/10 py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[16px] leading-snug font-semibold text-navy [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/10 text-lg leading-none text-teal-dark transition-transform duration-300 group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-[15px] leading-relaxed text-navy/70">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar: sticky TOC + sibling posts, desktop only. The narrow
           reading column stays narrow for line-length; this is what the
           freed-up side space does instead of sitting empty. -->
      {(toc.length > 0 || relatedArticles.length > 0) && (
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-5">
            {toc.length > 0 && (
              <nav class="reveal rounded-2xl border border-navy/10 bg-off/60 p-5" aria-label="Table of contents" style="--d:220ms">
                <p class="text-xs font-semibold tracking-[0.12em] text-navy/50 uppercase">On this page</p>
                <ul class="mt-3 space-y-2 text-[13.5px]">
                  {toc.map((item) => (
                    <li class={item.level === 3 ? 'pl-4' : ''}>
                      <a href={`#${item.id}`} class="text-navy/70 transition-colors hover:text-teal-dark">{item.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {relatedArticles.length > 0 && (
              <div class="reveal rounded-2xl border border-navy/10 p-5" style="--d:260ms">
                <p class="text-xs font-semibold tracking-[0.12em] text-navy/50 uppercase">Keep reading</p>
                <ul class="mt-3 space-y-4">
                  {relatedArticles.map((a) => (
                    <li>
                      <a href={withBase(a.href)} class="group block">
                        <p class="text-xs font-semibold tracking-wide text-teal-dark uppercase">{a.kicker}</p>
                        <p class="mt-1 font-display text-[14.5px] leading-snug font-semibold text-navy transition-colors group-hover:text-teal-dark">{a.title}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      )}
    </div>
  </div>

  <RelatedReading heading="Keep reading" items={relatedArticles} />
  <RelatedReading heading="The service this connects to" items={relatedServices} class="pt-0" />
</Base>
