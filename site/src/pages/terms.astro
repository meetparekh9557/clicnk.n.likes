---
// Terms of Use. Content ported verbatim in substance from v1, em dashes
// removed, plain-English register kept. Static legal page.
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';

const sections = [
  {
    h: 'Free tools & scores',
    p: 'Our free tools produce directional estimates from a documented, transparent scoring model, using either data fetched live from a page you submit or answers you self-report, and each result is labelled which. They are not a substitute for a full professional audit and carry no guarantee of outcomes.',
  },
  {
    h: 'Quotations',
    p: 'Prices generated by the plan builder are genuine and current, but they are indicative starting points. Final scope and pricing are confirmed in a written proposal before any engagement begins. Ad spend on paid platforms is always billed directly by the platform, never through us.',
  },
  {
    h: 'Fees & payment',
    p: 'Fees are as set out in your written proposal, in the currency stated there (our base currency is INR; other currencies are shown at the prevailing rate and confirmed in the proposal). Monthly services are billed in advance; one-time projects are typically 50% to begin and 50% on delivery. Invoices are due within 7 days, and work may pause on overdue accounts until they are cleared. All fees are exclusive of tax. We are not currently registered for GST, so no GST is charged; if that changes, it will be added at the prevailing rate and shown separately.',
  },
  {
    h: 'Costs that are your own',
    p: 'Advertising spend, your domain, hosting and any CMS or plugin licences, premium stock, fonts or third-party tools, and photo/video shoot production are your own costs, paid directly by you, and are not included in our fees.',
  },
  {
    h: 'Your term, and the free months',
    p: 'Monthly services run for the term you choose \u2014 1, 3, 6 or 12 months \u2014 and are billed month by month, in advance. A term is not a lump sum paid upfront; it simply sets how long we work together and which incentives apply. On a 6-month term you are charged for 5 months and the 6th is free; on a 12-month term you are charged for 10 and the last 2 are free. The free months sit at the end of the term, so they are earned by completing it. The 15% multi-service discount applies for every month two or more services are active, and simply stops if you reduce to one. We never recalculate or claw back a discount on a month already delivered.',
  },
  {
    h: 'Revisions & approvals',
    p: 'Deliverables include the revision rounds set out in your proposal; further revisions are quoted separately. We ask for timely feedback, approvals, access and materials, and client-side delays may move timelines accordingly.',
  },
  {
    h: 'Cancellation',
    p: 'You may cancel at any time with 30 days\u2019 written notice. We keep delivering through that notice period and the fee for it remains payable. If you are part-way through a 6- or 12-month term you simply do not reach the free months at the end, and there is no penalty, exit fee or recalculation of past months. A one-time project may be cancelled before delivery with payment for the work completed to that point. We may cancel on the same 30 days\u2019 notice, and if we do so for any reason other than non-payment we will refund anything paid for work not yet delivered and hand over everything in a usable state. Either of us may end the engagement immediately for a material breach that is not put right within 14 days.',
  },
  {
    h: 'Refunds',
    p: 'Fees for work already delivered are not refundable, because the work has been done. Anything you have paid in advance for work not yet delivered is refunded in full, or credited against future work if you prefer, within 14 working days of the engagement ending. On a one-time project, the commencement payment is refundable to the extent it exceeds the value of the work completed when you cancel. Advertising budget sits with the ad platform and never with us, so any unspent amount is refunded under that platform\u2019s rules and claimed by you directly. Domains, hosting, licences and third-party tools are bought in your own name and follow the relevant provider\u2019s terms. If a deliverable does not match what your proposal describes, tell us within 14 days and we will put it right at our cost, as a priority.',
  },
  {
    h: 'Ownership of the work',
    p: 'On full payment, the final deliverables we create for you become yours. We keep our own pre-existing tools, methods and templates, and we may show non-confidential work in our portfolio unless you ask us not to.',
  },
  {
    h: 'What we guarantee, and what nobody can',
    p: "We guarantee the work. Everything set out in your proposal gets delivered to the agreed volumes and timelines, to a professional standard; we report honestly against the leads and enquiries generated rather than vanity metrics; we label clearly which findings are verified from live data and which are self-reported; and you always know what has been done and what is next. What no agency can guarantee is a specific ranking, traffic, lead or revenue figure, because those are decided by search and AI ranking systems, ad platforms, your competitors and your own market. Any agency promising you a number is guessing, and we would rather be the one that tells you so.",
  },
  {
    h: 'Limitation of liability',
    p: 'To the maximum extent permitted by law, we are not liable for any indirect or consequential loss, including lost revenue, profits or business, and our total liability for any claim is limited to the fees paid to us for the services in the three months before the claim.',
  },
  {
    h: 'Governing law',
    p: 'These terms and any engagement under them are governed by the laws of India and are subject to the jurisdiction of the competent courts of India. Where a signed proposal or agreement covers a point differently, that document takes precedence.',
  },
  {
    h: 'Content of this site',
    p: "All content, tools and design on clicknlikes.com belong to Click.n.likes. You're welcome to link to anything, but please do not republish our tools or content as your own.",
  },
  {
    h: 'Questions',
    plink: true,
  },
];
---

<Base
  title="Terms of Use | Click.n.likes"
  description="The ground rules for using clicknlikes.com: our free tools are honest estimates, our quotes are starting points, and nothing here replaces a signed proposal."
>
  <section class="mx-auto max-w-3xl px-[5vw] pt-16 pb-6 lg:pt-20">
    <p class="reveal inline-flex items-center gap-2 rounded-full border border-teal/30 bg-teal/5 px-4 py-1.5 text-[13px] font-semibold text-navy">
      <span class="h-1.5 w-1.5 rounded-full bg-teal"></span> Legal
    </p>
    <h1 class="reveal-mask mt-5 font-display text-[clamp(2rem,4vw,3rem)] leading-[1.1] font-bold text-navy">
      <span class="mask-line"><span>Terms of Use</span></span>
    </h1>
    <p class="reveal mt-4 text-lg leading-relaxed text-navy/70" style="--d:140ms">
      Short version: our free tools are honest estimates, our quotes are starting points, and nothing here replaces a
      signed agreement. Last updated: July 2026.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-[5vw] pb-16">
    <div class="space-y-8">
      {sections.map((s, i) => (
        <div class="reveal" style={`--d:${i * 60}ms`}>
          <h2 class="font-display text-lg font-semibold text-navy">{s.h}</h2>
          {s.plink ? (
            <p class="mt-2 text-[15.5px] leading-relaxed text-navy/70">
              Write to{' '}
              <a href={`mailto:${contact.email}`} class="font-medium text-teal-dark underline decoration-teal/40 underline-offset-2 hover:decoration-teal">{contact.email}</a>.
            </p>
          ) : (
            <p class="mt-2 text-[15.5px] leading-relaxed text-navy/70">{s.p}</p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
