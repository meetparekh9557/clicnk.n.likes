---
// Case study template. Figures come from the engagement's own reporting and
// are presented as they happened, including the ad-platform learning phase
// and the mid-engagement dip. The page carries the same no-prediction line
// as clause 12.3 of our Master Services Agreement, so what we publish in
// marketing and what we sign in a contract say the same thing.
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import LeadChart from '../../components/LeadChart.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import InlineCta from '../../components/InlineCta.astro';
import { caseStudies } from '../../data/caseStudies';
import { withBase } from '../../lib/url';
import { abs, breadcrumbSchema } from '../../lib/seo';
import Check from '@lucide/astro/icons/check';

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { cs: c } }));
}
const { cs } = Astro.props;

// Asset presence is detected at build time rather than tracked by a flag, so
// dropping a file into public/work/ is all it takes to make it appear. A
// missing screenshot or logo simply renders nothing instead of a broken
// image, and no placeholder ever stands in for a real client's website.
const asset = (p?: string) => (p && existsSync(new URL(`../../../public${p}`, import.meta.url)) ? p : undefined);
const logo = asset(cs.logo);
const shotBefore = asset(cs.shotBefore);
const shotAfter = asset(cs.shotAfter);
const shot = asset(cs.shot);
const gallery = (cs.gallery ?? []).filter((g) => asset(g.src));
const hasShots = Boolean(shotBefore || shotAfter);

const trail: [string, string][] = [
  ['Home', '/'],
  ['Work', '/work/'],
  [cs.client, `/work/${cs.slug}/`],
];
const jsonLd = [
  breadcrumbSchema(trail),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${cs.client}: ${cs.title}`,
    description: cs.excerpt,
    url: abs(`/work/${cs.slug}/`),
    author: { '@id': 'https://clicknlikes.com/#organization' },
    publisher: { '@id': 'https://clicknlikes.com/#organization' },
  },
];
const hasLeads = Boolean(cs.leads && cs.leads.length > 0);
const firstTotal = hasLeads ? cs.leads![0].paid + cs.leads![0].organic : 0;
const lastTotal = hasLeads ? cs.leads![cs.leads.length - 1].paid + cs.leads![cs.leads.length - 1].organic : 0;
---

<Base
  title={`${cs.client} Case Study: ${cs.title} | Click.n.likes`}
  description={cs.excerpt}
  jsonLd={jsonLd}
>
  <Breadcrumbs trail={trail} />
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-[5vw] pt-14 pb-8 lg:pt-18">
    <a href={withBase('/work/')} class="reveal text-sm font-semibold text-navy/55 transition-colors hover:text-teal-dark">← All work</a>

    <div class="reveal mt-6 flex flex-wrap items-center gap-4" style="--d:60ms">
      {logo && (
        <img src={withBase(logo)} alt={`${cs.client} logo`} width="180" height="56" class="h-11 w-auto object-contain" loading="eager" />
      )}
      <span class="inline-flex items-center gap-2 rounded-full border border-teal/30 bg-teal/5 px-4 py-1.5 text-[13px] font-semibold text-navy">
        <span class="h-1.5 w-1.5 rounded-full bg-teal"></span> {cs.tag}
      </span>
    </div>

    <h1 class="reveal-mask mt-5 max-w-3xl font-display text-[clamp(2rem,4.2vw,3.1rem)] leading-[1.08] font-bold text-navy">
      <span class="mask-line"><span>{cs.title}</span></span>
    </h1>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy/70" style="--d:180ms">{cs.excerpt}</p>

    <dl class="reveal mt-8 grid gap-x-8 gap-y-4 border-t border-navy/10 pt-6 sm:grid-cols-2 lg:grid-cols-4" style="--d:240ms">
      <div><dt class="text-[11.5px] font-semibold tracking-[0.1em] text-navy/45 uppercase">Client</dt><dd class="mt-1 text-[15px] font-semibold text-navy">{cs.client}</dd></div>
      <div><dt class="text-[11.5px] font-semibold tracking-[0.1em] text-navy/45 uppercase">Engagement</dt><dd class="mt-1 text-[15px] text-navy/75">{cs.period ? <>{cs.period}<span class="block text-[13px] text-navy/50">{cs.lengthLabel}</span></> : cs.lengthLabel}</dd></div>
      <div><dt class="text-[11.5px] font-semibold tracking-[0.1em] text-navy/45 uppercase">Sector</dt><dd class="mt-1 text-[15px] text-navy/75">{cs.sector}</dd></div>
      <div><dt class="text-[11.5px] font-semibold tracking-[0.1em] text-navy/45 uppercase">Services</dt><dd class="mt-1 text-[15px] text-navy/75">{cs.services.join(', ')}</dd></div>
    </dl>
  </section>

  <!-- Headline stats -->
  {cs.stats && cs.stats.length > 0 && (
    <section class="mx-auto max-w-5xl px-[5vw] pb-4">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {cs.stats.map((s, i) => (
          <div class="reveal rounded-2xl border border-navy/10 bg-white p-5" style={`--d:${i * 70}ms`}>
            <p class="font-display text-[clamp(1.6rem,3vw,2.1rem)] leading-none font-bold text-teal-dark tabular-nums">{s.value}</p>
            <p class="mt-2 text-[14px] font-semibold text-navy">{s.label}</p>
            {s.sub && <p class="mt-1 text-[12.5px] leading-snug text-navy/55">{s.sub}</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- The chart -->
  {hasLeads && (
    <section class="mx-auto max-w-5xl px-[5vw] pt-12 pb-4">
      <p class="reveal text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Leads, month by month</p>
      <h2 class="reveal mt-3 max-w-3xl font-display text-[clamp(1.5rem,2.8vw,2.2rem)] leading-[1.15] font-bold text-navy" style="--d:80ms">
        {firstTotal} leads a month at the start. {lastTotal} at the close.
      </h2>
      <p class="reveal mt-3 max-w-2xl text-[15.5px] leading-relaxed text-navy/65" style="--d:140ms">
        Shown exactly as it happened, including the two flat months while the ad platforms learned the account and the
        dip mid-engagement before further optimisation. Growth that only ever goes up is not what running live campaigns
        looks like.
      </p>
      <div class="reveal mt-7 rounded-2xl border border-navy/10 bg-white p-5 sm:p-7" style="--d:200ms">
        <LeadChart leads={cs.leads} id={`lc-${cs.slug}`} />
      </div>
    </section>
  )}

  <!-- Narrative -->
  <section class="mx-auto max-w-3xl px-[5vw] pt-12 pb-4">
    <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">The client</h2>
    <p class="reveal mt-3 text-[16.5px] leading-relaxed text-navy/75" style="--d:60ms">{cs.overview}</p>

    <h2 class="reveal mt-10 font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">The challenge</h2>
    <p class="reveal mt-3 text-[16.5px] leading-relaxed text-navy/75" style="--d:60ms">{cs.challenge}</p>
  </section>

  <!-- Approach -->
  <section class="mx-auto max-w-5xl px-[5vw] pt-10 pb-4">
    <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">How we sequenced it</h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {cs.approach.map((a, i) => (
        <Card class="reveal flex flex-col" style={`--d:${i * 90}ms`}>
          <span class="font-display text-3xl font-bold text-teal/40 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-display text-base font-semibold text-navy">{a.phase}</h3>
          <p class="mt-1 text-[12.5px] font-semibold text-teal-dark">{a.when}</p>
          <p class="mt-3 text-[14.5px] leading-relaxed text-navy/70">{a.body}</p>
        </Card>
      ))}
    </div>
  </section>

  <!-- Website before / after, or a single shot for a from-scratch build -->
  {(shotBefore && shotAfter) || hasShots ? (
    <section class="mx-auto max-w-5xl px-[5vw] pt-12 pb-4">
      <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">The website, before and after</h2>

      {shotBefore && shotAfter ? (
        <div class="reveal mt-6" style="--d:80ms">
          <BeforeAfter
            before={withBase(shotBefore)}
            after={withBase(shotAfter)}
            alt={`${cs.client} website`}
            id={`ba-${cs.slug}`}
          />
        </div>
      ) : (
        <div class="reveal mt-6 grid gap-5 lg:grid-cols-2" style="--d:80ms">
          {shotBefore && (
            <figure>
              <img src={withBase(shotBefore)} alt={`${cs.client} website before the rebuild`} loading="lazy" class="w-full rounded-xl border border-navy/10" />
              <figcaption class="mt-2 text-[12.5px] font-semibold text-navy/50">Before</figcaption>
            </figure>
          )}
          {shotAfter && (
            <figure>
              <img src={withBase(shotAfter)} alt={`${cs.client} website after the rebuild`} loading="lazy" class="w-full rounded-xl border border-teal/40" />
              <figcaption class="mt-2 text-[12.5px] font-semibold text-teal-dark">After</figcaption>
            </figure>
          )}
        </div>
      )}

      {cs.siteCompare && cs.siteCompare.length > 0 && (
        <div class="reveal mt-6 overflow-x-auto rounded-2xl border border-navy/10" style="--d:120ms">
          <table class="w-full min-w-[560px] border-collapse text-left text-[14.5px]">
            <thead>
              <tr class="bg-navy text-white">
                <th class="px-5 py-3 font-semibold"></th>
                <th class="px-5 py-3 font-semibold">Before</th>
                <th class="px-5 py-3 font-semibold">After</th>
              </tr>
            </thead>
            <tbody>
              {cs.siteCompare.map((r, i) => (
                <tr class={i % 2 ? 'bg-off/60' : 'bg-white'}>
                  <th scope="row" class="px-5 py-3 font-semibold text-navy">{r.row}</th>
                  <td class="px-5 py-3 text-navy/60">{r.before}</td>
                  <td class="px-5 py-3 font-medium text-navy">
                    <span class="inline-flex items-start gap-2">
                      <span class="mt-0.5 grid h-[17px] w-[17px] shrink-0 place-items-center rounded-full bg-teal/15 text-teal-dark"><Check size={11} stroke-width={3} aria-hidden="true" /></span>
                      {r.after}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  ) : gallery.length > 0 ? (
    <section class="mx-auto max-w-5xl px-[5vw] pt-12 pb-4">
      <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">The website</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {gallery.map((g, i) => (
          <figure class="reveal" style={`--d:${i * 80}ms`}>
            <img src={withBase(g.src)} alt={g.caption ?? `${cs.client} website`} loading="lazy" class="w-full rounded-xl border border-navy/10" />
            {g.caption && <figcaption class="mt-2 text-[12.5px] text-navy/50">{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  ) : shot && (
    <section class="mx-auto max-w-5xl px-[5vw] pt-12 pb-4">
      <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">The website</h2>
      <figure class="reveal mt-6" style="--d:80ms">
        <img src={withBase(shot)} alt={`${cs.client} website`} loading="lazy" class="w-full rounded-xl border border-navy/10" />
      </figure>
    </section>
  )}

  <!-- Results -->
  <section class="mx-auto max-w-3xl px-[5vw] pt-12 pb-4">
    {cs.results && cs.results.length > 0 && (
      <>
        <h2 class="reveal font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">What actually happened</h2>
        {cs.results.map((r, i) => (
          <div class="reveal mt-7" style={`--d:${i * 70}ms`}>
            <h3 class="font-display text-lg font-semibold text-navy">{r.h}</h3>
            <p class="mt-2 text-[16.5px] leading-relaxed text-navy/75">{r.p}</p>
          </div>
        ))}
      </>
    )}

    {cs.feedback && (
      <div class="reveal mt-9 rounded-2xl border-l-[3px] border-teal bg-teal/[0.06] p-6" style="--d:80ms">
        <p class="text-xs font-semibold tracking-[0.12em] text-teal-dark uppercase">In their world</p>
        <p class="mt-2 text-[15.5px] leading-relaxed text-navy/75">{cs.feedback}</p>
      </div>
    )}

    <h2 class="reveal mt-11 font-display text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-navy">In summary</h2>
    <p class="reveal mt-3 text-[16.5px] leading-relaxed text-navy/75" style="--d:60ms">{cs.summary}</p>

    {cs.results && cs.results.length > 0 && (
      <p class="reveal mt-8 rounded-xl border border-navy/10 bg-off px-5 py-4 text-[13px] leading-relaxed text-navy/55" style="--d:120ms">
        These figures describe this engagement only. They are reported from the campaign and analytics reporting for this
        account, and they are not a prediction or promise of comparable results. What any business achieves depends on its
        market, offer, pricing and competition, and no agency controls the search and advertising platforms these results
        run on.
      </p>
    )}
  </section>

  <section class="mx-auto max-w-5xl px-[5vw] py-14">
    <InlineCta
      eyebrow="Want this sequencing for your business?"
      title="Start with the free scan, and see where you actually stand."
      primaryLabel="Build your plan"
      secondaryLabel="Scan my site free"
    />
  </section>
</Base>
