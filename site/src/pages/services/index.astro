---
// Services overview: a dedicated Meta ads landing page, not a normal
// site page - noindex, so it never shows up organically. Custom minimal
// header (logo, left) and footer (logo + copyright/legal only) instead
// of the full site Nav/Footer, so nothing pulls attention away from the
// page's own job: build trust fast, then convert via the form or
// WhatsApp. Local SEO is deliberately left out of the channel list and
// the form's service picker on this page only (the real site keeps it
// everywhere else) - a standing instruction for this page specifically.
import Base from '../../layouts/Base.astro';
import SimpleForm from '../../components/islands/SimpleForm.jsx';
import { serviceDetails } from '../../data/services';
import { caseStudies } from '../../data/caseStudies';
import { contact } from '../../data/site';
import { withBase } from '../../lib/url';
import Search from '@lucide/astro/icons/search';
import Sparkles from '@lucide/astro/icons/sparkles';
import Share2 from '@lucide/astro/icons/share-2';
import FileText from '@lucide/astro/icons/file-text';
import Monitor from '@lucide/astro/icons/monitor';
import Megaphone from '@lucide/astro/icons/megaphone';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Eye from '@lucide/astro/icons/eye';
import Zap from '@lucide/astro/icons/zap';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Layers from '@lucide/astro/icons/layers';
import Check from '@lucide/astro/icons/check';
import Phone from '@lucide/astro/icons/phone';

const year = new Date().getFullYear();

// This page only - every other page keeps all 7.
const adsServices = serviceDetails.filter((s) => s.slug !== 'local-seo');

const serviceIcons: Record<string, any> = {
  seo: Search,
  'ai-seo': Sparkles,
  'social-media-growth': Share2,
  'content-marketing': FileText,
  'website-development': Monitor,
  'paid-campaigns': Megaphone,
};
const ctaLabel: Record<string, string> = {
  seo: 'Start with SEO',
  'ai-seo': 'Get cited by AI',
  'social-media-growth': 'Grow on social',
  'content-marketing': 'Start with content',
  'website-development': 'Get a website quote',
  'paid-campaigns': 'Start ad management',
};
// What the client actually gets from each channel - outcome-framed, but
// grounded in the real included deliverables already published on each
// service's own page (data/services.ts `cards`), not new claims.
const benefits: Record<string, string[]> = {
  seo: ['Rank for the exact terms your buyers search', 'Technical fixes that stop leaks in traffic and rankings', 'Blog content built to move specific keywords, not just publish'],
  'ai-seo': ["Get cited by ChatGPT, Gemini and Google's AI Overview", 'Schema that makes your entity unmistakable to crawlers', 'Tracked citations, so you see exactly where AI mentions you'],
  'social-media-growth': ['Content calendars mapped to real business goals', 'Hooks and captions built to stop the scroll', 'A real playbook for turning DMs into leads'],
  'content-marketing': ['Blogs and guides built around real search demand', 'Landing page copy that pairs with your website and converts', 'Every piece structured so AI Overviews can cite it too'],
  'website-development': ['Sub-2-second mobile loads, not a bloated template', 'Every page engineered around one clear action', 'You own it outright, no lock-in to a proprietary builder'],
  'paid-campaigns': ['Campaigns built for DMs and form fills, not just clicks', 'Retargeting that brings back visitors your content already warmed up', 'Cost per lead reported weekly, not buried in a monthly PDF'],
};

// Real, sourced, dated results from two published case studies - never
// invented for this page. Kept high on the page, not buried at the
// bottom, since this is the trust signal that actually earns the click.
const aidbylaw = caseStudies.find((c) => c.slug === 'aidbylaw')!;
const kopaSeamless = caseStudies.find((c) => c.slug === 'kopa-seamless')!;
const resultStats = [
  { ...kopaSeamless.stats![0], client: kopaSeamless.client },
  { ...aidbylaw.stats![3], client: aidbylaw.client },
  { ...kopaSeamless.stats![1], client: kopaSeamless.client },
  { ...aidbylaw.stats![0], client: aidbylaw.client },
];

// The real "How we're different" claims from the homepage, verbatim -
// never invented for this page.
const whyUs = [
  { icon: Eye, title: 'Pricing you can see', text: 'Most agencies hide pricing behind a sales call. Ours is published, tiered and starts at ₹16,000.' },
  { icon: Zap, title: 'Audits that actually run', text: 'Most "free audits" are empty lead-gen forms. Ours run real, transparent scoring the second you submit.' },
  { icon: TrendingUp, title: 'Leads, not vanity metrics', text: 'Most agencies report clicks and impressions. We report the leads and enquiries the work actually generated.' },
  { icon: Layers, title: 'One team, seven channels', text: 'Most agencies hand you between vendors for SEO, social, content and ads. We run it all under one roof.' },
];

const waMessage = "Hi Click.n.likes, I'd like to grow my business. Can you help?";
const waHref = `${contact.whatsappHref}?text=${encodeURIComponent(waMessage)}`;
const telHref = `tel:${contact.whatsappHref.replace('https://wa.me/', '+')}`;

// Real, already-published answers - the refund/invoicing terms are the
// same ones stated on the pricing page's quote calculator, and the
// timeline figure is the same sourced stat used on /why-organic/. Never
// invented for this page.
const faqs = [
  {
    q: 'How long until we see results?',
    a: "Depends on the channel. Paid campaigns can start sending leads within days. Organic work (SEO, content, AI SEO) compounds - Google's own guidance is four months to a year before it fully kicks in, which is also why most engagements run both at once: paid for now, organic for what keeps working after.",
  },
  {
    q: "What's the contract, and what if it doesn't work out?",
    a: 'A term is invoiced once, up front. If we part ways early, every month you\'ve paid for but not received is refunded in full within 14 working days - the same terms on our pricing page, not different terms for ads traffic.',
  },
  {
    q: 'Do you guarantee rankings or results?',
    a: 'No, and any agency that does is not being straight with you. What we do guarantee is honest reporting: the actual leads and enquiries the work produced, not clicks or impressions dressed up as results.',
  },
];

const formFields = [
  { name: 'name', label: 'Full name', placeholder: 'Your name' },
  { name: 'email', label: 'Email', type: 'email', placeholder: 'you@business.com' },
  { name: 'business', label: 'Business name', placeholder: 'Your business', required: false, optional: 'optional' },
  { name: 'phone', label: 'WhatsApp number', type: 'tel', placeholder: '+91 98765 43210' },
  {
    name: 'services_interested', label: 'Which services are you interested in?', type: 'chips', full: true,
    options: adsServices.map((s) => s.title),
  },
];

// Two fields only - the whole point is a visitor can inquire without
// scrolling past the hero. Separate tag from the full form below so
// owner-notification emails show which one someone actually used.
const heroFormFields = [
  { name: 'name', label: 'Full name', placeholder: 'Your name' },
  { name: 'phone', label: 'WhatsApp number', type: 'tel', placeholder: '+91 98765 43210' },
];
---

<Base
  title="Our Services: SEO, AI Search, Social, Content, Websites, Paid | Click.n.likes"
  description="Full-stack organic growth: SEO, AI SEO, social, content, websites and paid campaigns. Published pricing, free live checks, no sales call required."
  noindex
  bare
>
  <!-- Minimal header: logo only, left-aligned. -->
  <header class="border-b border-navy/10 px-[5vw] py-5">
    <img src={withBase('/logo-wordmark.png')} alt="Click.n.likes" width="156" height="26" class="h-[26px] w-auto" />
  </header>

  <!-- Hero: headline + subhead + a row of real trust badges (not empty) + primary CTA. -->
  <section class="relative overflow-hidden bg-navy">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image:radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px); background-size:26px 26px;"></div>
    <div class="relative mx-auto max-w-3xl px-[5vw] py-16 text-center lg:py-20">
      <p class="reveal inline-flex items-center gap-2 rounded-full border border-teal/40 bg-teal/10 px-4 py-1.5 text-[13px] font-semibold text-teal">
        <span class="h-1.5 w-1.5 rounded-full bg-teal"></span> Full-stack organic growth
      </p>
      <h1 class="reveal-mask mt-5 font-display text-[clamp(2.1rem,4.6vw,3.3rem)] leading-[1.08] font-bold text-white">
        <span class="mask-line"><span>Six channels.</span></span>
        <span class="mask-line" style="--d:120ms"><span class="text-teal">One growth engine.</span></span>
      </h1>
      <p class="reveal mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/70" style="--d:220ms">
        Pick the one channel that's costing you the most right now, or let us run the whole stack: every service below
        is built to feed the others, not compete with them for budget.
      </p>
      <div class="reveal mx-auto mt-8 max-w-md rounded-3xl border-[1.5px] border-teal/40 bg-teal/[0.06] p-1.5 text-left" style="--d:280ms">
        <SimpleForm
          client:load
          tag="services-ads-hero"
          fields={heroFormFields}
          submitLabel="Get my recommendation"
          thankYouHref={withBase('/thank-you/')}
        />
      </div>
      <div class="reveal mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-white/60" style="--d:320ms">
        <a href={waHref} target="_blank" rel="noopener" data-track="whatsapp_click" class="inline-flex items-center gap-1.5 font-semibold text-white transition-colors hover:text-teal">
          Or chat on WhatsApp
        </a>
        <span class="text-white/25">·</span>
        <a href="#lead-form" class="inline-flex items-center gap-1.5 font-semibold text-white transition-colors hover:text-teal">
          See all 6 services first
        </a>
      </div>
      <div class="reveal mt-10 grid grid-cols-3 gap-3 border-t border-white/10 pt-8 text-left sm:gap-6" style="--d:340ms">
        <div>
          <p class="font-display text-xl font-bold text-teal sm:text-2xl">₹16,000</p>
          <p class="mt-1 text-[12.5px] leading-snug text-white/60">Published pricing, no sales call to find out</p>
        </div>
        <div>
          <p class="font-display text-xl font-bold text-teal sm:text-2xl">6</p>
          <p class="mt-1 text-[12.5px] leading-snug text-white/60">Channels, one team, nothing between vendors</p>
        </div>
        <div>
          <p class="font-display text-xl font-bold text-teal sm:text-2xl">Free</p>
          <p class="mt-1 text-[12.5px] leading-snug text-white/60">Live site checks, no lead-gen quiz behind them</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real results: high on the page, sourced, dated, attributed - the actual trust signal. -->
  <section class="border-b border-navy/10 bg-off">
    <div class="mx-auto max-w-5xl px-[5vw] py-16">
      <p class="reveal text-center text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Real client results</p>
      <h2 class="reveal mt-3 text-center font-display text-[clamp(1.6rem,3.2vw,2.2rem)] leading-[1.15] font-bold text-navy" style="--d:80ms">
        Not projections. Numbers from live campaigns.
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {resultStats.map((s, i) => (
          <div class="reveal rounded-2xl border border-navy/10 bg-white p-5" style={`--d:${i * 80}ms`}>
            <div class="flex items-center gap-2">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/10 text-teal-dark"><TrendingUp size={13} stroke-width={2.6} aria-hidden="true" /></span>
              <div class="font-display text-3xl font-bold text-teal-dark">{s.value}</div>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-navy/70">{s.label}</p>
            <p class="mt-3 text-xs font-medium text-navy/45">{s.client} · {s.sub}</p>
          </div>
        ))}
      </div>
      <div class="reveal mt-10 text-center" style="--d:120ms">
        <a href="#lead-form" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-coral">
          Get results like these
          <ArrowRight size={16} stroke-width={2.4} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why choose us: the real, already-published differentiators. -->
  <section class="mx-auto max-w-5xl px-[5vw] py-16">
    <p class="reveal text-center text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Why choose us</p>
    <h2 class="reveal mt-3 text-center font-display text-[clamp(1.6rem,3.2vw,2.2rem)] leading-[1.15] font-bold text-navy" style="--d:80ms">
      Not another agency with a "book a call" button.
    </h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {whyUs.map((w, i) => (
        <div class="reveal rounded-2xl border border-navy/10 bg-white p-6 shadow-[0_10px_30px_rgba(26,43,74,0.06)]" style={`--d:${i * 70}ms`}>
          <div class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-teal/10 text-teal-dark"><w.icon size={22} stroke-width={2} aria-hidden="true" /></div>
          <h3 class="font-display text-lg font-semibold text-navy">{w.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy/60">{w.text}</p>
        </div>
      ))}
    </div>
    <div class="reveal mt-10 text-center" style="--d:120ms">
      <a href="#lead-form" class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-navy/15 px-6 py-3.5 text-sm font-semibold text-navy transition-colors hover:border-teal hover:text-teal-dark">
        Talk to us
        <ArrowRight size={16} stroke-width={2.4} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- What you get: the benefits of working with us overall, spelled out. -->
  <section class="border-t border-navy/10 bg-navy">
    <div class="mx-auto max-w-4xl px-[5vw] py-16 text-center">
      <p class="reveal text-xs font-semibold tracking-[0.14em] text-teal uppercase">What you get</p>
      <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3.2vw,2.2rem)] leading-[1.15] font-bold text-white" style="--d:80ms">
        This is what actually changes once we start.
      </h2>
      <div class="mt-10 grid gap-5 text-left sm:grid-cols-2">
        {[
          { title: 'A plan built on your numbers, not a guess', text: 'Every engagement starts with a real look at your site and rankings, so the plan is built on where you actually stand, not a template pitch.' },
          { title: 'Leads that keep arriving after the campaign ends', text: 'Organic work compounds: rankings and content built this quarter keep sending enquiries long after, unlike a channel that switches off the day ad spend stops.' },
          { title: 'One accountable team, not four vendors', text: 'SEO, content, social, websites and ads run under one roof, so nothing gets lost in the handoff between a designer, a freelancer and an ads agency.' },
          { title: 'Full visibility into what is actually running', text: 'You see the real leads and enquiries the work produced, in plain English - not clicks and impressions dressed up as results.' },
        ].map((b, i) => (
          <div class="reveal flex items-start gap-3" style={`--d:${i * 70}ms`}>
            <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/15 text-teal"><Check size={14} stroke-width={2.8} aria-hidden="true" /></span>
            <div>
              <p class="font-display text-[15px] font-semibold text-white">{b.title}</p>
              <p class="mt-1 text-[13.5px] leading-relaxed text-white/60">{b.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="reveal mt-10" style="--d:120ms">
        <a href="#lead-form" class="inline-flex items-center gap-2 rounded-full bg-teal px-6 py-3.5 text-sm font-semibold text-navy transition-all duration-300 hover:-translate-y-0.5 hover:bg-white">
          Get this for your business
          <ArrowRight size={16} stroke-width={2.4} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Channels: 3 cards per row (2 rows of 3), each with its own CTA that
       scrolls to (and pre-checks) the form. -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-5xl px-[5vw] py-16">
      <p class="reveal text-center text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">What we do</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {adsServices.map((s, i) => {
          const Icon = serviceIcons[s.slug];
          return (
            <div class="reveal flex flex-col rounded-2xl border border-navy/10 bg-white p-6 shadow-[0_10px_30px_rgba(26,43,74,0.06)]" style={`--d:${(i % 3) * 90}ms`}>
              <div class="flex items-center gap-3">
                <span class="font-display text-sm font-bold text-navy/25 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <div class="grid h-11 w-11 place-items-center rounded-xl bg-teal/10 text-teal-dark">
                  <Icon size={22} stroke-width={2} aria-hidden="true" />
                </div>
              </div>
              <h2 class="mt-4 font-display text-lg font-semibold text-navy">{s.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-navy/60">{s.lead}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {benefits[s.slug].map((b) => (
                  <li class="flex items-start gap-2 text-[13px] leading-snug text-navy/70">
                    <Check size={15} stroke-width={2.6} class="mt-0.5 shrink-0 text-teal-dark" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
              <a
                href="#lead-form"
                data-preselect={s.title}
                class="mt-5 inline-flex items-center justify-center gap-1.5 rounded-full border-[1.5px] border-navy/15 px-4 py-2.5 text-[13px] font-semibold text-navy transition-colors hover:border-teal hover:text-teal-dark"
              >
                {ctaLabel[s.slug]}
                <ArrowRight size={14} stroke-width={2.4} aria-hidden="true" />
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FAQ: real, already-published answers - timeline, contract terms, results risk. -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-3xl px-[5vw] py-16">
      <p class="reveal text-center text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Before you ask</p>
      <h2 class="reveal mt-3 text-center font-display text-[clamp(1.6rem,3.2vw,2.2rem)] leading-[1.15] font-bold text-navy" style="--d:80ms">
        Three things people ask before they reach out.
      </h2>
      <div class="mt-10 space-y-5">
        {faqs.map((f, i) => (
          <div class="reveal rounded-2xl border border-navy/10 bg-white p-6" style={`--d:${i * 80}ms`}>
            <p class="font-display text-[15px] font-semibold text-navy">{f.q}</p>
            <p class="mt-2 text-sm leading-relaxed text-navy/65">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The form: the page's main conversion path. -->
  <section id="lead-form" class="mx-auto max-w-2xl scroll-mt-24 px-[5vw] py-20 text-center">
    <p class="reveal text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase" style="--d:80ms">Not sure which one?</p>
    <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3.2vw,2.2rem)] leading-[1.15] font-bold text-navy" style="--d:120ms">
      Tell us what you're struggling with, we'll point you the right way.
    </h2>
    <!-- Trust repeated right beside the form itself, not just earlier on the page. -->
    <div class="reveal mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px] font-semibold text-navy/60" style="--d:140ms">
      <span class="inline-flex items-center gap-1.5"><span class="text-teal-dark">71%</span> of Kopa Seamless's leads now from organic</span>
      <span class="hidden text-navy/25 sm:inline">·</span>
      <span class="inline-flex items-center gap-1.5"><span class="text-teal-dark">340-390</span> leads/mo at close for AidByLaw</span>
    </div>
    <div class="reveal mt-8 rounded-3xl border-[1.5px] border-teal/40 bg-teal/[0.04] p-1.5 text-left" style="--d:180ms">
      <SimpleForm
        client:visible
        tag="services-ads"
        fields={formFields}
        submitLabel="Get my recommendation"
        thankYouHref={withBase('/thank-you/')}
        footnote="We reply within 24 hours. No spam, ever."
      />
    </div>
    <p class="reveal mt-5 text-sm text-navy/55" style="--d:220ms">
      Prefer to talk now?
      <a href={waHref} target="_blank" rel="noopener" data-track="whatsapp_click" class="font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2">Message us on WhatsApp</a>
      or <a href={telHref} data-track="call_click" class="font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2">call {contact.whatsappDisplay}</a>
    </p>
  </section>

  <!-- Minimal footer: logo + copyright + Privacy/Terms. -->
  <footer class="border-t border-navy/10 py-8 text-center">
    <img src={withBase('/logo-wordmark.png')} alt="Click.n.likes" width="130" height="22" class="mx-auto h-[22px] w-auto opacity-70" />
    <p class="mt-4 text-[12.5px] text-navy/50">
      © {year} Click.n.likes. All rights reserved.
      <span class="mx-1.5">·</span>
      <a href={withBase('/privacy/')} class="hover:text-teal-dark hover:underline">Privacy</a>
      <span class="mx-1">·</span>
      <a href={withBase('/terms/')} class="hover:text-teal-dark hover:underline">Terms</a>
    </p>
  </footer>

  <!-- Floating WhatsApp button, prefilled for this page's context. -->
  <a
    href={waHref}
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
    data-track="whatsapp_click"
    class="fixed right-4 bottom-4 z-30 inline-flex items-center gap-2 rounded-full bg-[#25D366] py-3 pr-5 pl-4 font-semibold text-white shadow-[0_12px_30px_rgba(37,211,102,0.45)] transition-transform duration-300 ease-out-quart hover:-translate-y-0.5 sm:right-6 sm:bottom-6"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
