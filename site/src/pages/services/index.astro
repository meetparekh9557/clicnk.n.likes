  <script>
    import { trackEvent } from '../../lib/engine';

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const preselectBtn = target.closest('[data-preselect]');
      if (preselectBtn) {
        const value = preselectBtn.getAttribute('data-preselect');
        if (value) {
          const detail = { field: 'services_interested', value };
          (window as any).__cnlPreselect = detail;
          window.dispatchEvent(new CustomEvent('cnl:preselect', { detail }));
        }
      }

      // GA4 event on every WhatsApp/call touchpoint on this page (hero,
      // floating button, near-form link) - there is no Meta Pixel or
      // Google Ads conversion tag installed on the site to also fire yet.
      const trackBtn = target.closest('[data-track]');
      if (trackBtn) {
        trackEvent(trackBtn.getAttribute('data-track') || 'click', { page: 'services_ads' });
      }
    });
  </script>
