---
// Site-wide Thank You page: the single URL every form on the site sends
// people to after a successful submission - lead forms, quote calculators,
// newsletter. Rebuilt from a full-nav "explore the site" page into a
// focused post-conversion page: the visitor already said yes once, so the
// job here is one clear next step (talk now via WhatsApp, or wait), not a
// mini content library. Minimal header (logo + back-to-website) instead of
// the full site Nav - fewer exits, matching a dedicated conversion page,
// not a normal browsing page. Footer stays (real contact info is useful).
// Still noindex,nofollow - a confirmation page has no reason to rank.
//
// Two things intentionally NOT built here, called out rather than faked:
// - No "Book a call" button: there is no booking/Calendly system anywhere
//   in this codebase. WhatsApp is the real, working "talk sooner" path,
//   so it's the primary CTA instead. Add a real booking tool first if a
//   literal book-a-call button is wanted.
// - No founder photo: About page already made this call deliberately (see
//   its own comment) - name + LinkedIn, no photo, because there isn't a
//   real one to use. Reused the same honest pattern here rather than
//   inventing a photo just for this page.
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import CircleCheck from '@lucide/astro/icons/circle-check';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Search from '@lucide/astro/icons/search';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { withBase } from '../lib/url';
import { caseStudies } from '../data/caseStudies';
import { contact } from '../data/site';

const featuredCaseStudies = ['aidbylaw', 'kopa-seamless']
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({ title: `${c.client} case study`, desc: c.excerpt, href: `/work/${c.slug}/` }));

const waMessage = "Hi Click.n.likes, I just submitted an enquiry and wanted to follow up.";
const waHref = `${contact.whatsappHref}?text=${encodeURIComponent(waMessage)}`;

const steps = [
  'We review your enquiry',
  'A strategist looks at your business and requirements',
  'We get back to you within 1 business day',
];
---

<Base
  title="Thank You | Click.n.likes"
  description="Your submission has been received."
  noindex
  hideNav
  hideCta
  hideChat
>
  <!-- Minimal header: logo + a single way back, not the full site nav. -->
  <header class="border-b border-navy/10 px-[5vw] py-5">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <img src={withBase('/logo-wordmark.png')} alt="Click.n.likes" width="156" height="26" class="h-[26px] w-auto" />
      <a href={withBase('/')} data-track="back_to_website" class="text-sm font-medium text-navy/55 transition-colors hover:text-teal-dark">
        Back to website
      </a>
    </div>
  </header>

  <section class="mx-auto flex max-w-xl flex-col items-center px-[5vw] py-16 text-center">
    <span class="reveal grid h-16 w-16 place-items-center rounded-full bg-teal/10 text-teal-dark">
      <CircleCheck size={36} stroke-width={1.8} aria-hidden="true" />
    </span>
    <h1 class="reveal-mask mt-6 font-display text-[clamp(1.8rem,4vw,2.6rem)] leading-[1.12] font-bold text-navy">
      <span class="mask-line"><span>Your enquiry is in.</span></span>
      <span class="mask-line" style="--d:100ms"><span class="text-teal-dark">Let's talk growth.</span></span>
    </h1>
    <p class="reveal mt-4 text-lg leading-relaxed text-navy/70" style="--d:180ms">
      We've received your enquiry. A strategist reviews every submission personally and gets back to you within
      <b>1 business day</b>, usually much faster.
    </p>

    <!-- What happens next: the one thing a thank-you page usually skips. -->
    <div class="reveal mt-8 w-full rounded-2xl border border-navy/10 bg-off/60 p-6 text-left" style="--d:240ms">
      <p class="text-xs font-semibold tracking-[0.14em] text-navy/45 uppercase">What happens next</p>
      <ol class="mt-4 space-y-3">
        {steps.map((s, i) => (
          <li class="flex items-start gap-3">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/15 text-[12px] font-bold text-teal-dark">{i + 1}</span>
            <span class="text-[14.5px] leading-snug text-navy/75">{s}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- One dominant next step: talk now, not browse. Call leads (a real
         15-min slot, no back-and-forth), WhatsApp is the lighter-weight
         second path for someone who'd rather just message first. -->
    <div class="reveal mt-8 w-full" style="--d:300ms">
      <p class="text-sm font-semibold text-navy">Don't want to wait?</p>
      <a
        href="https://calendar.app.google/UXbHMxN9UZuuHqFUA"
        target="_blank"
        rel="noopener"
        data-track="book_call_click"
        class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral sm:w-auto"
      >
        Book a 15-minute call
        <ArrowRight size={16} stroke-width={2.4} aria-hidden="true" />
      </a>
      <p class="mt-3 text-sm text-navy/55">
        or
        <a href={waHref} target="_blank" rel="noopener" data-track="whatsapp_click" class="font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2">
          chat with us on WhatsApp
        </a>
      </p>
      <p class="mt-3 text-[12.5px] text-navy/45">No spam. No automated sales sequence - just a strategist reading what you sent.</p>
    </div>

    <!-- The human behind "reviewed personally" - real name, real LinkedIn,
         no photo (same honest choice the About page already made). -->
    <div class="reveal mt-8 flex w-full items-center gap-3 rounded-2xl border border-navy/10 bg-white p-4 text-left" style="--d:340ms">
      <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-navy/5 font-display text-sm font-bold text-navy/60">MP</div>
      <div class="flex-1">
        <p class="text-[13px] font-semibold text-navy">A real person is reviewing this</p>
        <p class="text-[12.5px] text-navy/55">Meet Parekh, Founder</p>
      </div>
      <a
        href="https://www.linkedin.com/in/meetparekh21/"
        target="_blank"
        rel="noopener"
        aria-label="Meet Parekh on LinkedIn"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-navy/15 text-navy transition-colors hover:border-teal hover:bg-teal/10 hover:text-teal-dark"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zm7.5 0h3.8v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-7.9c0-1.88-.03-4.3-2.62-4.3-2.62 0-3.02 2.05-3.02 4.17V23H8V8z"/></svg>
      </a>
    </div>
  </section>

  <!-- One strong next step while they wait: real results, 2 only. -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-4xl px-[5vw] py-14">
      <p class="reveal text-center text-sm text-navy/55" style="--d:100ms">While you wait, see what we've done for businesses like yours:</p>
      <div class="mt-6 grid gap-5 text-left sm:grid-cols-2">
        {featuredCaseStudies.map((c, i) => (
          <Card href={c.href} data-track="case_study_click" class="reveal group" style={`--d:${160 + i * 80}ms`}>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal/10 text-teal-dark">
              <TrendingUp size={20} stroke-width={2} aria-hidden="true" />
            </div>
            <p class="mt-3 flex items-start justify-between gap-2 text-[15px] font-semibold leading-snug text-navy">
              <span>{c.title}</span>
              <ArrowRight size={15} stroke-width={2.4} class="mt-0.5 shrink-0 text-navy/30 transition-colors group-hover:text-teal-dark" aria-hidden="true" />
            </p>
            <p class="mt-2 text-[13px] leading-relaxed text-navy/55">{c.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Free tool, framed as connected to the enquiry rather than a random promo. -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-2xl px-[5vw] py-14 text-center">
      <p class="reveal text-sm font-semibold text-navy/70" style="--d:100ms">Want to see what we'll look at?</p>
      <p class="reveal mt-2 text-[15px] leading-relaxed text-navy/60" style="--d:140ms">
        Run our free website check and see 11 verified signals from your own site, emailed to you, no call required.
      </p>
      <a
        href={withBase('/tools/')}
        data-track="tool_click"
        class="reveal mt-5 inline-flex items-center gap-2 rounded-full border-[1.5px] border-navy/15 px-6 py-3.5 text-sm font-semibold text-navy transition-colors hover:border-teal hover:text-teal-dark"
        style="--d:180ms"
      >
        <Search size={16} stroke-width={2.4} aria-hidden="true" />
        Run the free check
      </a>
    </div>
  </section>

  <script>
    import { trackEvent } from '../lib/engine';

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trackBtn = target.closest('[data-track]');
      if (trackBtn) {
        trackEvent(trackBtn.getAttribute('data-track') || 'click', { page: 'thank_you' });
      }
    });
  </script>
</Base>
