---
// Site-wide Thank You page: the single URL every form on the site sends
// people to after a successful submission - lead forms, quote calculators,
// newsletter. Originally a pure `bare` dead end for Meta/Google Ads
// conversion-tracking cleanliness, but no ad pixel is actually installed
// anywhere in this codebase (confirmed, before one was later added and
// verified to work regardless of noindex/bare status) and the standalone
// ads landing page that was the reason for that isolation has since been
// deleted - so a converted visitor sitting on a true dead end was a wasted
// engagement opportunity, not a tracking safeguard. Real Nav + Footer +
// chat button now stay on (matching the 404 page's treatment), only the
// CtaBand is hidden to avoid a redundant second CTA under the curated
// explore section below. Still noindex,nofollow - a confirmation page has
// no reason to rank.
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import CircleCheck from '@lucide/astro/icons/circle-check';
import FileText from '@lucide/astro/icons/file-text';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Search from '@lucide/astro/icons/search';
import Layers from '@lucide/astro/icons/layers';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { articles } from '../data/articles';
import { caseStudies } from '../data/caseStudies';

const latestPosts = articles.slice(0, 2).map((a) => ({ tag: 'From the blog', icon: FileText, title: a.title, desc: a.excerpt, href: `/insights/${a.slug}/` }));
const featuredCaseStudies = ['aidbylaw', 'kopa-seamless']
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({ tag: 'Real results', icon: TrendingUp, title: `${c.client} case study`, desc: c.excerpt, href: `/work/${c.slug}/` }));

// One flat card grid, ordered blog -> case studies -> tools/services, not
// 3 separate stacked lists - each card carries its own tag so the order
// still reads even without group headings. desc on every card (real
// excerpts already published for blog/case-study entries; a genuine
// one-line description for the other two) so cards read full at the
// sitewide 1400px container width instead of stretching mostly-empty.
const exploreCards = [
  ...latestPosts,
  ...featuredCaseStudies,
  { tag: 'Free tools', icon: Search, title: 'Run a free live site check', desc: 'The same live scan from the homepage - 11 verified signals, emailed to you, no call required.', href: '/tools/' },
  { tag: 'Services', icon: Layers, title: 'See what we run for clients', desc: 'SEO, AI search, content, social, websites and paid - published pricing, no sales call to find out.', href: '/services/seo/' },
];
---

<Base
  title="Thank You | Click.n.likes"
  description="Your submission has been received."
  noindex
  hideCta
>
  <section class="mx-auto flex min-h-screen max-w-6xl flex-col items-center justify-center px-[5vw] py-20 text-center">
    <div class="mx-auto flex max-w-xl flex-col items-center">
      <span class="reveal grid h-16 w-16 place-items-center rounded-full bg-teal/10 text-teal-dark">
        <CircleCheck size={36} stroke-width={1.8} aria-hidden="true" />
      </span>
      <h1 class="reveal-mask mt-6 font-display text-[clamp(1.8rem,4vw,2.6rem)] leading-[1.12] font-bold text-navy">
        <span class="mask-line"><span>Got it, thank you.</span></span>
      </h1>
      <p class="reveal mt-4 max-w-md text-lg leading-relaxed text-navy/70" style="--d:120ms">
        A strategist reviews every submission personally and replies within <b>1 business day</b>, usually much
        faster. Check your inbox (and spam folder, just in case) for a confirmation.
      </p>
    </div>

    <div class="reveal mt-12 w-full border-t border-navy/10 pt-10" style="--d:200ms">
      <p class="text-sm text-navy/50">While you wait, here's a place to start:</p>
      <div class="mt-6 grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-3">
        {exploreCards.map((c, i) => (
          <Card href={c.href} class="reveal group" style={`--d:${240 + i * 60}ms`}>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal/10 text-teal-dark">
              <c.icon size={20} stroke-width={2} aria-hidden="true" />
            </div>
            <p class="mt-4 text-[11px] font-semibold tracking-[0.1em] text-navy/40 uppercase">{c.tag}</p>
            <p class="mt-1.5 flex items-start justify-between gap-2 text-[15px] font-semibold leading-snug text-navy">
              <span>{c.title}</span>
              <ArrowRight size={15} stroke-width={2.4} class="mt-0.5 shrink-0 text-navy/30 transition-colors group-hover:text-teal-dark" aria-hidden="true" />
            </p>
            <p class="mt-2 text-[13px] leading-relaxed text-navy/55">{c.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</Base>
