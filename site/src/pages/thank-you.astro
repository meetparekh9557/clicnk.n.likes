---
// Site-wide Thank You page: the single URL every form on the site sends
// people to after a successful submission - lead forms, quote calculators,
// newsletter. Focused post-conversion page: the visitor already said yes
// once, so the job here is one clear next step (book a call or WhatsApp
// now, or wait), not a mini content library. Header and footer use the
// real site Nav/Footer, same as every other page - header/footer stay
// consistent site-wide; only a dedicated ads landing page (none exists
// right now) gets the stripped-down, non-navigable treatment, same as the
// old /services/ ads page did before it was removed. Still noindex,nofollow
// - a confirmation page has no reason to rank.
//
// One thing intentionally not built here, called out rather than faked:
// a founder photo. The About page already made this call deliberately (see
// its own comment) - name + LinkedIn, no photo, because there isn't a real
// one to use.
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import CircleCheck from '@lucide/astro/icons/circle-check';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Search from '@lucide/astro/icons/search';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { withBase } from '../lib/url';
import { caseStudies } from '../data/caseStudies';
import { contact } from '../data/site';

const featuredCaseStudies = ['aidbylaw', 'kopa-seamless']
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({ title: `${c.client} case study`, desc: c.excerpt, href: `/work/${c.slug}/` }));

const waMessage = "Hi Click.n.likes, I just submitted an enquiry and wanted to follow up.";
const waHref = `${contact.whatsappHref}?text=${encodeURIComponent(waMessage)}`;

const steps = [
  'We review your enquiry',
  'A strategist looks at your business and requirements',
  'We get back to you within 1 business day',
];
---

<Base
  title="Thank You | Click.n.likes"
  description="Your submission has been received."
  noindex
  hideCta
  hideChat
>
  <section class="mx-auto flex max-w-xl flex-col items-center px-[5vw] py-16 text-center">
    <span class="reveal grid h-16 w-16 place-items-center rounded-full bg-teal/10 text-teal-dark">
      <CircleCheck size={36} stroke-width={1.8} aria-hidden="true" />
    </span>
    <h1 class="reveal-mask mt-6 font-display text-[clamp(1.8rem,4vw,2.6rem)] leading-[1.12] font-bold text-navy">
      <span class="mask-line"><span>Your enquiry is in.</span></span>
      <span class="mask-line" style="--d:100ms"><span class="text-teal-dark">Let's talk growth.</span></span>
    </h1>
    <p class="reveal mt-4 text-lg leading-relaxed text-navy/70" style="--d:180ms">
      We've received your enquiry. A strategist reviews every submission personally and gets back to you within
      <b>1 business day</b>, usually much faster.
    </p>

    <!-- What happens next: the one thing a thank-you page usually skips. -->
    <div class="reveal mt-8 w-full rounded-2xl border border-navy/10 bg-off/60 p-6 text-left" style="--d:240ms">
      <p class="text-xs font-semibold tracking-[0.14em] text-navy/45 uppercase">What happens next</p>
      <ol class="mt-4 space-y-3">
        {steps.map((s, i) => (
          <li class="flex items-start gap-3">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-teal/15 text-[12px] font-bold text-teal-dark">{i + 1}</span>
            <span class="text-[14.5px] leading-snug text-navy/75">{s}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- One dominant next step: talk now, not browse. Both are real,
         equally-weighted buttons - call for a fixed slot, WhatsApp (its
         own brand green) for whoever would rather just message first. -->
    <p class="reveal mt-8 text-sm font-semibold text-navy" style="--d:280ms">Don't want to wait?</p>
    <div class="reveal mt-3 flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center" style="--d:300ms">
      <a
        href="https://calendar.app.google/UXbHMxN9UZuuHqFUA"
        target="_blank"
        rel="noopener"
        data-track="book_call_click"
        class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral sm:w-auto"
      >
        Book a 15-minute call
        <ArrowRight size={16} stroke-width={2.4} aria-hidden="true" />
      </a>
      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:brightness-95 sm:w-auto"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.34 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.9 9.9 0 0 0 12.04 2zm0 18.13h-.003a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.55-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43l-.48-.01c-.16 0-.43.06-.66.31-.22.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.24 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"></path></svg>
        Chat on WhatsApp
      </a>
    </div>
    <p class="reveal mt-4 text-[12.5px] text-navy/45" style="--d:320ms">No spam. No automated sales sequence - just a strategist reading what you sent.</p>
  </section>

  <!-- One strong next step while they wait: real results, 2 only. -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-14">
      <p class="reveal text-center text-sm text-navy/55" style="--d:100ms">While you wait, see what we've done for businesses like yours:</p>
      <div class="mt-6 grid gap-5 text-left sm:grid-cols-2">
        {featuredCaseStudies.map((c, i) => (
          <Card href={c.href} data-track="case_study_click" class="reveal group" style={`--d:${160 + i * 80}ms`}>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal/10 text-teal-dark">
              <TrendingUp size={20} stroke-width={2} aria-hidden="true" />
            </div>
            <p class="mt-3 flex items-start justify-between gap-2 text-[15px] font-semibold leading-snug text-navy">
              <span>{c.title}</span>
              <ArrowRight size={15} stroke-width={2.4} class="mt-0.5 shrink-0 text-navy/30 transition-colors group-hover:text-teal-dark" aria-hidden="true" />
            </p>
            <p class="mt-2 text-[13px] leading-relaxed text-navy/55">{c.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Free tool, framed as connected to the enquiry rather than a random promo. -->
  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-2xl px-[5vw] py-14 text-center">
      <p class="reveal text-sm font-semibold text-navy/70" style="--d:100ms">Want to see what we'll look at?</p>
      <p class="reveal mt-2 text-[15px] leading-relaxed text-navy/60" style="--d:140ms">
        Run our free website check and see 11 verified signals from your own site, emailed to you, no call required.
      </p>
      <a
        href={withBase('/tools/')}
        data-track="tool_click"
        class="reveal mt-5 inline-flex items-center gap-2 rounded-full border-[1.5px] border-navy/15 px-6 py-3.5 text-sm font-semibold text-navy transition-colors hover:border-teal hover:text-teal-dark"
        style="--d:180ms"
      >
        <Search size={16} stroke-width={2.4} aria-hidden="true" />
        Run the free check
      </a>
    </div>
  </section>

  <script>
    import { trackEvent } from '../lib/engine';

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trackBtn = target.closest('[data-track]');
      if (trackBtn) {
        trackEvent(trackBtn.getAttribute('data-track') || 'click', { page: 'thank_you' });
      }
    });
  </script>
</Base>
