  <script>
    import { trackEvent } from '../lib/engine';

    // Sticky CTA: hidden while the hero (with its own big CTA + form) is
    // in view, shown once the visitor scrolls past it.
    const hero = document.getElementById('hero');
    const sticky = document.getElementById('sticky-cta');
    if (hero && sticky) {
      const io = new IntersectionObserver(
        ([entry]) => {
          const show = !entry.isIntersecting;
          sticky.classList.toggle('translate-y-full', !show);
          sticky.classList.toggle('opacity-0', !show);
          sticky.classList.toggle('translate-y-0', show);
          sticky.classList.toggle('opacity-100', show);
        },
        { threshold: 0 }
      );
      io.observe(hero);
    }

    // Delegated click tracking for every data-track element on the page,
    // same pattern used elsewhere on the site.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trackBtn = target.closest('[data-track]');
      if (trackBtn) {
        trackEvent(trackBtn.getAttribute('data-track') || 'click', { page: 'growth' });
      }
    });

    // Scroll depth: fire once per milestone per page view.
    const milestones = [25, 50, 75, 90];
    const fired = new Set<number>();
    window.addEventListener('scroll', () => {
      const scrolled = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
      milestones.forEach((m) => {
        if (scrolled >= m && !fired.has(m)) {
          fired.add(m);
          trackEvent('scroll_depth', { page: 'growth', percent: m });
        }
      });
    }, { passive: true });
  </script>
