---
// Dedicated Meta-ads landing page for paid video traffic. NOT the main
// site - a focused, single-conversion page built from a detailed brief.
// noindex: same standing reasoning as every other paid-traffic page this
// project has built - a page written for pre-warmed ad traffic competing
// in Google against the real /services/ pages would be duplicate/thin
// content and could hurt those pages' rankings. Full canonical/OG/schema
// still built per the brief - costs nothing, and is there if the founder
// ever wants it indexed.
//
// Two honest deviations from the brief, flagged in chat before this was
// built:
// - Trust section has no founder photo. None exists - the About page
//   already made this exact call (name + LinkedIn, no photo) and this
//   page reuses that same honest pattern rather than inventing one.
// - "9 years", not "10+" - the real, sourced figure used everywhere else
//   on the site (About, homepage). Never round a real number up.
// - "Free Growth Scan" is the existing live Website Health Scan tool
//   (/tools/), rebranded in this page's copy only - not a second engine.
// - Only 2 real case studies (AidByLaw, Kopa Seamless) are quantified.
//   Adamas Films has no stats array (a design/build project, not an SEO
//   retainer) - using it here would mean inventing numbers it doesn't have.
import Base from '../layouts/Base.astro';
import SimpleForm from '../components/islands/SimpleForm.jsx';
import { withBase } from '../lib/url';
import { serviceDetails } from '../data/services';
import { caseStudies } from '../data/caseStudies';
import { contact } from '../data/site';
import { SITE_ORIGIN } from '../lib/seo';
import Search from '@lucide/astro/icons/search';
import Sparkles from '@lucide/astro/icons/sparkles';
import Share2 from '@lucide/astro/icons/share-2';
import FileText from '@lucide/astro/icons/file-text';
import Monitor from '@lucide/astro/icons/monitor';
import Megaphone from '@lucide/astro/icons/megaphone';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import X from '@lucide/astro/icons/x';
import TrendingUp from '@lucide/astro/icons/trending-up';

// This page only - every other page keeps all 7 services.
const services = serviceDetails.filter((s) => s.slug !== 'local-seo');
const serviceIcons: Record<string, any> = {
  seo: Search,
  'ai-seo': Sparkles,
  'social-media-growth': Share2,
  'content-marketing': FileText,
  'website-development': Monitor,
  'paid-campaigns': Megaphone,
};
const serviceCopy: Record<string, string> = {
  seo: 'Build long-term visibility where your customers are already searching.',
  'ai-seo': "Improve your brand's visibility across AI-powered search and answer engines.",
  'social-media-growth': 'Build attention and trust around your brand.',
  'content-marketing': 'Create content that attracts, educates and moves potential customers toward action.',
  'website-development': 'Turn visitors into enquiries with better messaging, UX and conversion.',
  'paid-campaigns': 'Use Google and Meta Ads to acquire customers when paid acquisition makes sense.',
};

// Real, quantified case studies only - see file header.
const aidbylaw = caseStudies.find((c) => c.slug === 'aidbylaw')!;
const kopaSeamless = caseStudies.find((c) => c.slug === 'kopa-seamless')!;
const featured = [aidbylaw, kopaSeamless];

const waMessage = "Hi Click.n.likes, I'd like to talk about my business's growth.";
const waHref = `${contact.whatsappHref}?text=${encodeURIComponent(waMessage)}`;

const problemOptions = [
  'Not enough leads', "SEO isn't generating results", "Website isn't converting", "Ads aren't profitable",
  'Competitors are outperforming us', 'Need more AI Search visibility', 'Need help with overall marketing', 'Not sure',
];
const improveOptions = [
  'Generate more leads', 'Increase organic traffic', 'Improve SEO', 'Improve AI Search visibility',
  'Increase website conversions', 'Improve paid advertising', 'Build a stronger content strategy',
  'Improve social media', 'Need an overall marketing strategy', 'Not sure',
];

const heroFields = [
  { name: 'name', label: 'Name', placeholder: 'Your name' },
  { name: 'business', label: 'Business / Brand', placeholder: 'Your business' },
  { name: 'website', label: 'Website URL', placeholder: 'yoursite.com', required: false, optional: 'optional' },
  { name: 'email', label: 'Work email', type: 'email', placeholder: 'you@business.com' },
  { name: 'phone', label: 'WhatsApp / Phone', type: 'phone', placeholder: '234 567 8900' },
  { name: 'city', label: 'City', placeholder: 'Your city' },
  { name: 'country', label: 'Country', type: 'country' },
  { name: 'problem', label: "What's currently not working?", type: 'select', full: true, emptyFirst: true, options: ['Choose one', ...problemOptions] },
];
const finalFields = [
  ...heroFields,
  { name: 'goal', label: 'What are you trying to improve?', type: 'select', full: true, emptyFirst: true, options: ['Choose one', ...improveOptions] },
  { name: 'message', label: "Tell us what's currently not working", type: 'textarea', full: true, required: false, optional: 'optional', placeholder: 'The more specific, the better we can help.' },
];

const faqs = [
  { q: 'Will you try to sell me everything?', a: 'No. We recommend only what makes sense for your business.' },
  { q: 'Do I need to know which service I need?', a: "No. Tell us what's not working. We'll help identify the likely problem." },
  { q: 'Do you guarantee rankings?', a: "No. We'd rather tell you what is realistic than make promises we can't control." },
  { q: 'Do you work with businesses outside India?', a: 'Yes. We work with businesses across different markets and adapt the strategy to the market you\'re targeting.' },
  { q: 'Will someone actually review my enquiry?', a: 'Yes. Your enquiry is reviewed by the Click.n.likes team rather than disappearing into a generic contact inbox.' },
  { q: "I've worked with agencies before. Why should this be different?", a: 'We start by understanding the business problem instead of immediately selling a service. We identify the gaps, prioritise them and explain what we believe should happen next.' },
  { q: 'How much does it cost?', a: 'Our pricing is published in full on the website rather than quoted privately, so you can see the numbers before you ever speak to us. What a particular business should spend depends on what it actually needs, which is what the conversation is for.' },
  { q: "What if I'm not sure I even need an agency?", a: "That's a reasonable place to start, and you don't need to resolve it before getting in touch. Tell us what's happening and we'll help you work out whether there is a problem worth paying anyone to solve." },
];

const canonicalURL = `${SITE_ORIGIN}/growth/`;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Growth Assessment | Click.n.likes',
  url: canonicalURL,
  isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
};
---

<Base
  title="Growth Assessment: Find What's Not Working | Click.n.likes"
  description="Tell us what's not working in your marketing. We'll help identify the growth gaps and recommend what deserves attention first - SEO, AI Search, content, social, websites and paid, working together."
  canonical={canonicalURL}
  noindex
  bare
  jsonLd={[faqSchema, webPageSchema]}
>
  <!-- Minimal nav: logo, 4 anchor links, one CTA. No dropdowns, no blog,
       no tools, no site-wide nav - minimizing exits is the whole point. -->
  <header id="growth-nav" class="sticky top-0 z-40 border-b border-navy/10 bg-white/90 px-[5vw] py-4 backdrop-blur-xl transition-shadow duration-300">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <img src={withBase('/logo-wordmark.png')} alt="Click.n.likes" width="150" height="25" class="h-[25px] w-auto" />
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Page sections">
        <a href="#how-it-works" class="text-[14px] font-medium text-navy/70 hover:text-teal-dark">How It Works</a>
        <a href="#results" class="text-[14px] font-medium text-navy/70 hover:text-teal-dark">Results</a>
        <a href="#why-us" class="text-[14px] font-medium text-navy/70 hover:text-teal-dark">Why Us</a>
        <a href="#faq" class="text-[14px] font-medium text-navy/70 hover:text-teal-dark">FAQ</a>
      </nav>
      <a href="#hero-form" data-track="hero_inquiry_click" class="inline-flex items-center gap-1.5 rounded-full bg-navy px-5 py-2.5 text-[13.5px] font-semibold text-white transition-colors hover:bg-coral">
        Send My Enquiry
      </a>
    </div>
  </header>

  <!-- ============ 1. HERO + INQUIRY FORM ============ -->
  <section id="hero" class="border-b border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-12 lg:py-16">
      <div class="grid items-start gap-x-12 gap-y-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="reveal">
          <h1 class="reveal-mask font-display text-[clamp(2rem,4.2vw,3rem)] leading-[1.1] font-bold text-navy">
            <span class="mask-line"><span>Your Business Doesn't Need More Marketing.</span></span>
            <span class="mask-line" style="--d:100ms"><span class="text-teal-dark">It Needs To Know What's Not Working.</span></span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-navy/70">
            If you're getting traffic but not enough enquiries, spending on ads without seeing enough return,
            struggling to rank, watching competitors take the customers you should be winning, or simply unsure
            where your marketing is leaking, we'll help you find the gap.
          </p>
          <p class="mt-5 text-[15px] font-semibold text-navy">
            SEO. AI Search. Content. Social. Websites. Paid Campaigns.
            <span class="block font-normal text-navy/60">One strategy. Built around your actual business problem.</span>
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#hero-form" data-track="hero_inquiry_click" class="inline-flex items-center gap-2 rounded-full bg-navy px-7 py-4 text-[15px] font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral">
              Send My Enquiry
              <ArrowRight size={17} stroke-width={2.4} aria-hidden="true" />
            </a>
          </div>
          <p class="mt-3 text-[13px] text-navy/50">Tell us what's not working. We'll take it from there.<br />No generic pitch. No obligation to hire us.</p>
        </div>

        <div id="hero-form" class="reveal scroll-mt-24 rounded-2xl border-[1.5px] border-navy/10 bg-white p-1.5 shadow-[0_18px_50px_rgba(26,43,74,0.10)]" style="--d:140ms">
          <div class="p-5 pb-1 text-center">
            <p class="font-display text-lg font-bold text-navy">Let's Look At Your Business.</p>
          </div>
          <SimpleForm
            client:load
            tag="growth-hero"
            fields={heroFields}
            submitLabel="Send My Enquiry"
            thankYouHref={withBase('/growth/thank-you/')}
            footnote="A real person from Click.n.likes will review your enquiry."
            startEventName="inquiry_form_start"
            submitEventName="inquiry_form_submit"
          />
          <!-- Cold traffic's unanswered question is not "do I have a problem"
               (the page answers that repeatedly) but "what do I actually get
               for filling this in". Stated plainly, next to the form, and
               deliberately promising only what we will really do. -->
          <div class="border-t border-navy/10 px-5 py-5">
            <p class="text-[13px] font-semibold text-navy">What happens after you send it</p>
            <ol class="mt-3 space-y-2.5">
              {[
                'We read what you have shared and look at the areas connected to it.',
                'We work out what we would investigate or fix first, and why.',
                'We tell you what we think, including if the answer is that you do not need us yet.',
              ].map((t, i) => (
                <li class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-navy/65">
                  <span class="mt-px grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full bg-teal/15 text-[11px] font-bold text-teal-dark tabular-nums">{i + 1}</span>
                  {t}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. SOUND FAMILIAR? ============ -->
  <section class="border-b border-navy/10 bg-white">
    <div class="mx-auto max-w-3xl px-[5vw] py-16 text-center">
      <h2 class="reveal font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">Sound Familiar?</h2>
      <ul class="reveal mt-8 space-y-4 text-left text-lg leading-relaxed text-navy/75" style="--d:80ms">
        <li>You're getting website visitors, but enquiries are inconsistent.</li>
        <li>You're investing in ads, but you're not sure they're profitable.</li>
        <li>You're publishing content, but it isn't bringing customers.</li>
        <li>Your competitors keep appearing ahead of you.</li>
        <li>Your website looks professional, but isn't converting enough visitors.</li>
        <li>You're hearing about AI Search, GEO and AEO, but don't know what actually matters.</li>
        <li>You've tried marketing agencies before and still don't know what you got for the money.</li>
      </ul>
      <p class="reveal mt-8 text-lg font-semibold text-navy" style="--d:120ms">
        The problem may not be that you need more marketing.<br />You may need the right marketing working together.
      </p>
      <a href="#hero-form" data-track="hero_inquiry_click" class="reveal mt-6 inline-flex items-center gap-2 rounded-full border-[1.5px] border-navy/15 px-6 py-3.5 text-sm font-semibold text-navy transition-colors hover:border-teal hover:text-teal-dark" style="--d:160ms">
        Find Out What's Wrong
        <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- ============ 3. COST OF THE PROBLEM ============ -->
  <section class="border-b border-navy/10 bg-navy">
    <div class="mx-auto max-w-3xl px-[5vw] py-16 text-center">
      <h2 class="reveal font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-white">Every Weak Point In Your Marketing Has A Cost.</h2>
      <ul class="reveal mt-8 space-y-4 text-left text-lg leading-relaxed text-white/75" style="--d:80ms">
        <li>A slow website can lose enquiries.</li>
        <li>Poor search visibility can send potential customers to competitors.</li>
        <li>Weak content can leave your brand invisible when people are researching what you sell.</li>
        <li>A poor conversion path can turn expensive traffic into wasted ad spend.</li>
        <li>If your brand isn't visible where customers are searching, someone else gets the opportunity.</li>
      </ul>
      <p class="reveal mt-8 text-lg leading-relaxed text-white" style="--d:120ms">
        The question isn't <span class="text-white/60">"Should I spend more on marketing?"</span><br />
        It is <b class="text-teal">"Is my existing marketing actually working together?"</b>
      </p>
      <a href="#hero-form" data-track="hero_inquiry_click" class="reveal mt-6 inline-flex items-center gap-2 rounded-full bg-teal px-6 py-3.5 text-sm font-semibold text-navy transition-all duration-300 hover:-translate-y-0.5 hover:bg-white" style="--d:160ms">
        Find Out What's Wrong
        <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- ============ 4. AHA MOMENT ============ -->
  <section class="border-b border-navy/10 bg-white">
    <div class="mx-auto max-w-3xl px-[5vw] py-16 text-center">
      <h2 class="reveal font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">You Probably Don't Need More Marketing.</h2>
      <p class="reveal mt-2 text-lg font-semibold text-teal-dark" style="--d:60ms">You need to know what's already broken.</p>
      <ul class="reveal mt-8 space-y-4 text-left text-lg leading-relaxed text-navy/75" style="--d:100ms">
        <li>If your website doesn't convert, more traffic won't solve the problem.</li>
        <li>If your offer isn't clear, more ads won't solve the problem.</li>
        <li>If nobody can find you, better design won't solve the problem.</li>
        <li>If your content isn't aligned with what people search for, publishing more won't solve the problem.</li>
        <li>If your brand isn't visible in AI-powered search experiences, traditional SEO alone may not be enough.</li>
      </ul>
      <p class="reveal mt-8 text-lg font-semibold text-navy" style="--d:140ms">The first step isn't doing more.<br />It's knowing what to fix.</p>
      <a href="#hero-form" data-track="hero_inquiry_click" class="reveal mt-6 inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral" style="--d:180ms">
        Send My Enquiry
        <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- ============ 5. UNIQUE MECHANISM ============ -->
  <section class="border-b border-navy/10 bg-off">
    <div class="mx-auto max-w-3xl px-[5vw] py-16 text-center">
      <h2 class="reveal font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">We Don't Start With A Service. We Start With The Problem.</h2>
      <div class="reveal mt-8 text-left text-lg leading-relaxed text-navy/75" style="--d:80ms">
        <p>Most agencies begin with: <i>What service do you need? SEO? Google Ads? Social media? Website?</i></p>
        <p class="mt-4 font-semibold text-navy">We start somewhere else. <span class="font-normal text-navy/75">What's stopping your business from growing?</span></p>
        <p class="mt-4">Because the answer might not be SEO. It might be your website. It might be your offer. It
          might be conversion. It might be search visibility. It might be content. It might be paid acquisition.
          It might be several things working together.</p>
        <p class="mt-4 font-semibold text-navy">We find that first. Then we recommend what actually makes sense.</p>
      </div>
      <a href="#hero-form" data-track="hero_inquiry_click" class="reveal mt-6 inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral" style="--d:160ms">
        Find Out What's Wrong
        <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- ============ 6. HOW IT WORKS ============ -->
  <section id="how-it-works" class="scroll-mt-20 border-b border-navy/10 bg-white">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <h2 class="reveal text-center font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">First We Find The Leak. Then We Fix It.</h2>
      <p class="reveal mx-auto mt-3 max-w-xl text-center text-lg text-navy/65" style="--d:60ms">
        Your business doesn't necessarily need more channels. It needs the right channels working together.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {[
          { n: '01', t: 'Diagnose', d: 'We look at your search visibility, website, content, conversion journey, social presence and paid acquisition.' },
          { n: '02', t: 'Identify', d: 'We find the gaps costing you traffic, enquiries and customers.' },
          { n: '03', t: 'Prioritise', d: 'We separate what needs attention now from what can wait.' },
          { n: '04', t: 'Execute', d: 'Our team works across the channels your business actually needs.' },
          { n: '05', t: 'Measure', d: 'We focus on business outcomes, not reports filled with meaningless numbers.' },
        ].map((s, i) => (
          <div class="reveal rounded-2xl border border-navy/10 bg-off/60 p-5" style={`--d:${i * 70}ms`}>
            <p class="font-display text-2xl font-bold text-teal-dark/50 tabular-nums">{s.n}</p>
            <p class="mt-2 font-display text-base font-bold text-navy">{s.t}</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-navy/60">{s.d}</p>
          </div>
        ))}
      </div>
      <p class="reveal mt-10 text-center text-lg font-semibold text-navy" style="--d:120ms">
        Traffic is useful. <span class="text-teal-dark">Qualified enquiries and revenue are what matter.</span>
      </p>
      <div class="reveal mt-6 text-center" style="--d:160ms">
        <a href="#hero-form" data-track="hero_inquiry_click" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral">
          Find Out What's Wrong
          <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 7. SERVICES ============ -->
  <section class="border-b border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <h2 class="reveal text-center font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">One Growth Strategy. The Right Channels Working Together.</h2>
      <p class="reveal mx-auto mt-3 max-w-lg text-center text-lg text-navy/65" style="--d:60ms">
        You don't have to decide which service you need. Tell us your problem. We'll help identify what should come next.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => {
          const Icon = serviceIcons[s.slug];
          return (
            <div class="reveal rounded-2xl border border-navy/10 bg-white p-6" style={`--d:${(i % 3) * 80}ms`}>
              <div class="grid h-11 w-11 place-items-center rounded-xl bg-teal/10 text-teal-dark">
                <Icon size={21} stroke-width={2} aria-hidden="true" />
              </div>
              <h3 class="mt-4 font-display text-lg font-semibold text-navy">{s.title.split(' (')[0]}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy/60">{serviceCopy[s.slug]}</p>
            </div>
          );
        })}
      </div>
      <div class="reveal mt-10 text-center" style="--d:120ms">
        <a href="#hero-form" data-track="hero_inquiry_click" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral">
          Send My Enquiry
          <ArrowRight size={15} stroke-width={2.4} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 8. BEFORE / AFTER ============ -->
  <section class="border-b border-navy/10 bg-white">
    <div class="mx-auto max-w-4xl px-[5vw] py-16">
      <h2 class="reveal text-center font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-bold text-navy">From Scattered Marketing To A Clear Growth Strategy.</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="reveal rounded-2xl border border-navy/10 bg-off/60 p-6">
          <p class="text-xs font-semibold tracking-[0.12em] text-navy/40 uppercase">Before</p>
          <ul class="mt-4 space-y-3">
            {['Scattered marketing', 'Unclear priorities', 'Low search visibility', 'Traffic without enquiries', 'Ads without clear ROI', 'Content without direction', "Website that doesn't convert", 'No clear AI Search strategy'].map((t) => (
              <li class="flex items-start gap-2.5 text-[14.5px] text-navy/65"><X size={16} stroke-width={2.4} class="mt-0.5 shrink-0 text-navy/30" aria-hidden="true" />{t}</li>
            ))}
          </ul>
        </div>
        <div class="reveal rounded-2xl border-[1.5px] border-teal/40 bg-teal/[0.05] p-6" style="--d:100ms">
          <p class="text-xs font-semibold tracking-[0.12em] text-teal-dark uppercase">After</p>
          <ul class="mt-4 space-y-3">
            {['Clear growth strategy', 'Prioritised opportunities', 'Greater search visibility', 'More qualified enquiries', 'Measurable acquisition', 'Content built around demand', 'Website built to convert', 'Strategy for search and AI discovery'].map((t) => (
              <li class="flex items-start gap-2.5 text-[14.5px] font-medium text-navy"><Check size={16} stroke-width={2.6} class="mt-0.5 shrink-0 text-teal-dark" aria-hidden="true" />{t}</li>
            ))}
          </ul>
        </div>
      </div>
      <div class="reveal mt-10 text-center" style="--d:140ms">
