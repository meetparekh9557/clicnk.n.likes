---
// Pricing: tiered good-better-best, in the founder's voice. Prices are
// indicative monthly starting points (Terms: confirmed in a written
// proposal). Every rupee figure shown is a deliberate number whose digits
// sum to 6 or 7. Structured to serve both ends the founder flagged: a
// small business that cannot start at premium, and a premium buyer who
// would not trust an agency that only ever looks cheap.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Card from '../components/Card.astro';
import QuoteCalculator from '../components/islands/QuoteCalculator.jsx';
import CustomQuote from '../components/islands/CustomQuote.jsx';
import { withBase } from '../lib/url';
import { abs, breadcrumbSchema } from '../lib/seo';
import { CURRENCIES } from '../lib/currency.js';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';

// Tier ladder (per-service starting points). The exact scope at each tier is
// set in the plan builder + written proposal; the cards here are a glance of
// the ladder, not channel-count bundles. `highlight` marks the anchor tier.
const tiers = [
  { name: 'Starter', price: '₹16,000', inr: 16000, blurb: 'The essentials of a single service, run properly.', highlight: false },
  { name: 'Growth', price: '₹50,000', inr: 50000, blurb: 'More depth, faster cadence, tighter reporting.', highlight: true },
  { name: 'Pro', price: '₹1,24,000', inr: 124000, blurb: 'A serious, hands-on engagement at full depth.', highlight: false },
  { name: 'Custom', price: null, inr: null, blurb: 'Scoped and quoted with you.', highlight: false },
];

// What every plan includes, and the costs that are always the client's own
// (billed to them directly, never routed through us).
const includes = [
  'A documented strategy and onboarding call',
  'A named point of contact for your account',
  'All the execution listed in your chosen tier',
  'Reporting tied to real leads and enquiries, not vanity metrics',
  'The free live audit that sets the honest starting point',
];
const notes = [
  { h: 'Ad spend is yours, paid directly', t: 'Paid budget goes on your own card at Meta or Google, never routed through us. Our fee covers strategy, setup, creative and management only.' },
  { h: 'Domain, hosting & CMS are yours', t: 'For a website build, your domain, hosting and any CMS or plugin licence are bought in your own name and billed to you directly, with no lock-in.' },
  { h: 'Tools & production, only if approved', t: 'Premium stock, fonts or third-party tools are billed at cost only with your say-so. Photo and video shoots are arranged via our shoot partner and billed separately.' },
  { h: 'Every number is confirmed in writing', t: 'Prices here are honest starting points. Your exact scope and figure are set in a written proposal before any work begins.' },
];

// Published tier prices, expressed as an OfferCatalog. Amounts are the
// per-service monthly starting fees shown on the page (INR); Custom is
// excluded (no fixed price). Tied to the org as seller.
const trail: [string, string][] = [
  ['Home', '/'],
  ['Pricing', '/pricing/'],
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: 'Click.n.likes service tiers',
    url: abs('/pricing/'),
    itemListElement: tiers.filter((t) => t.inr).map((t) => ({
      '@type': 'Offer',
      name: t.name,
      description: t.blurb,
      priceCurrency: 'INR',
      price: t.inr,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: t.inr,
        priceCurrency: 'INR',
        unitText: 'MONTH',
      },
      seller: { '@id': 'https://clicknlikes.com/#organization' },
    })),
  },
  breadcrumbSchema(trail),
];
---

<Base
  title="Pricing: Organic Growth Plans from ₹16,000/mo | Click.n.likes"
  description="Transparent, tiered pricing for organic growth: Launch, Growth and Partner, from ₹16,000/month. Real work at every stage, no hidden retainers, ad spend always separate."
  jsonLd={jsonLd}
>
  <Breadcrumbs trail={trail} />
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-[5vw] pt-16 pb-8 lg:pt-20">
    <p class="reveal inline-flex items-center gap-2 rounded-full border border-teal/30 bg-teal/5 px-4 py-1.5 text-[13px] font-semibold text-navy">
      <span class="h-1.5 w-1.5 rounded-full bg-teal"></span> Pricing
    </p>
    <h1 class="reveal-mask mt-5 max-w-3xl font-display text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.08] font-bold text-navy">
      <span class="mask-line"><span>Pricing you can see,</span></span>
      <span class="mask-line" style="--d:120ms"><span>before you ever book a call.</span></span>
    </h1>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-navy/70" style="--d:240ms">
      Most agencies hide their pricing behind a sales call because the number is the weakest part of the pitch. We
      publish ours, because the businesses we work best with, from a local storefront to a manufacturer or a SaaS
      company, would rather start from an honest figure than a guarded one. There is a real entry point here, and there
      is real depth above it.
    </p>
  </section>

  <!-- Tiers -->
  <section class="mx-auto max-w-6xl px-[5vw] pb-6">
    <!-- Currency switcher: a rounded pill dropdown that auto-detects the
         visitor's currency and shows curated, hand-set clean prices per
         market (with a live-rate fallback for any other currency). Prices
         are display only; the contract is billed in the INR base. With no
         JS the honest INR figures render as authored. -->
    <div class="reveal relative z-30 mb-6 flex flex-wrap items-center gap-x-3 gap-y-1.5">
      <span class="text-[13px] font-semibold text-navy/70">Show prices in</span>
      <div class="relative" id="cnlCurWrap">
        <button
          type="button"
          id="cnlCurBtn"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="inline-flex min-w-[130px] items-center justify-between gap-2 rounded-full border-[1.5px] border-navy/15 bg-teal/10 px-4 py-2 text-[13.5px] font-semibold text-navy transition-colors hover:border-teal focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal"
        >
          <span id="cnlCurLabel">₹ INR</span>
          <ChevronDown size={15} stroke-width={2.4} aria-hidden="true" class="cnl-chev text-navy/50 transition-transform duration-300" />
        </button>
        <ul
          id="cnlCurMenu"
          role="listbox"
          class="invisible absolute top-full right-0 z-30 mt-2 min-w-[196px] origin-top-right -translate-y-1 rounded-2xl border border-navy/10 bg-white p-1.5 opacity-0 shadow-[0_18px_44px_rgba(26,43,74,0.16)] transition-all duration-200 ease-out-quart"
        >
          {Object.entries(CURRENCIES).map(([code, c]) => (
            <li
              role="option"
              data-cur={code}
              class="cursor-pointer rounded-full px-4 py-2.5 text-[13.5px] font-medium text-navy/75 transition-colors hover:bg-teal/10 hover:text-teal-dark aria-selected:bg-teal/10 aria-selected:font-semibold aria-selected:text-teal-dark"
            >{c.short}</li>
          ))}
        </ul>
      </div>
      <span id="cnlFxNote" class="text-[12px] text-navy/70"></span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tiers.map((tier, i) => (
        <div
          class={`reveal rounded-2xl border p-5 ${tier.highlight ? 'border-teal/60 bg-teal/[0.05] shadow-[0_12px_30px_rgba(26,43,74,0.08)]' : 'border-navy/10 bg-white'}`}
          style={`--d:${i * 70}ms`}
        >
          <div class="flex items-center justify-between gap-2">
            <h2 class="font-display text-base font-semibold text-navy">{tier.name}</h2>
            {tier.highlight && <span class="rounded-full bg-teal px-2.5 py-0.5 text-[10.5px] font-bold tracking-[0.06em] text-navy uppercase">Popular</span>}
          </div>
          <div class="mt-2 flex items-baseline gap-1">
            {tier.inr ? (
              <>
                <span class="text-[15px] font-semibold text-navy/45">from</span>
                <span class="cnl-price font-display text-3xl font-bold text-navy" data-inr={tier.inr}>{tier.price}</span>
                <span class="text-sm font-semibold text-navy/55">/mo</span>
              </>
            ) : (
              <a href="#custom" class="font-display text-2xl font-bold text-teal-dark underline decoration-teal/40 underline-offset-4 hover:decoration-teal">Let’s talk →</a>
            )}
          </div>
          <p class="mt-2 text-[13.5px] leading-relaxed text-navy/60">{tier.blurb}</p>
        </div>
      ))}
    </div>
    <p class="reveal mt-6 text-center text-sm text-navy/60" style="--d:120ms">
      These are per-service starting points. <a href="#quote" class="font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2 hover:decoration-teal">Build your exact plan</a> below — pick your services, set each tier and a duration. Two or more services take 15% off, and 6- or 12-month commitments come with free months.
    </p>
  </section>

  <!-- Instant quote calculator (live) -->
  <section id="quote" class="scroll-mt-28 border-t border-navy/10">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="reveal text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Build your plan</p>
        <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.12] font-bold text-navy" style="--d:80ms">
          Build your exact plan in a minute.
        </h2>
        <p class="reveal mt-3 text-lg text-navy/70" style="--d:140ms">
          Pick your services, set a tier for each, then add on exactly what you need. Choose a duration and the number
          updates live: two or more services take 15% off, and longer terms earn free months. Your term is invoiced once,
          up front, and anything paid for but not delivered is refunded in full.
        </p>
      </div>
      <div class="reveal mt-10" style="--d:180ms">
        <QuoteCalculator client:visible />
      </div>
    </div>
  </section>

  <!-- Custom quote builder (industry-aware, email-gated, unique reference) -->
  <section id="custom" class="scroll-mt-28 border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="reveal text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">Custom quote</p>
        <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.12] font-bold text-navy" style="--d:80ms">
          Need it built around your industry?
        </h2>
        <p class="reveal mt-3 text-lg text-navy/70" style="--d:140ms">
          Tell us your industry, what you want built and how hard you want to push. We build your number now, stamp it
          with a unique reference, and send the full breakdown you can turn into a proposal. Your industry shapes the
          plan, never the price.
        </p>
      </div>
      <div class="reveal mt-10" style="--d:180ms">
        <CustomQuote client:visible />
      </div>
    </div>
  </section>

  <!-- The honest notes -->
  <section class="border-t border-navy/10 bg-off">
    <div class="mx-auto max-w-6xl px-[5vw] py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="reveal text-xs font-semibold tracking-[0.14em] text-navy/50 uppercase">No fine print</p>
        <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.12] font-bold text-navy" style="--d:80ms">
          What's included, and what's billed to you directly.
        </h2>
      </div>

      <!-- What every plan includes -->
      <div class="reveal mx-auto mt-10 max-w-2xl rounded-2xl border border-teal/40 bg-teal/[0.05] p-6" style="--d:60ms">
        <h3 class="font-display text-base font-semibold text-navy">Every plan includes</h3>
        <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
          {includes.map((f) => (
            <li class="flex gap-2.5 text-[14px] leading-relaxed text-navy/75">
              <span class="mt-0.5 grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full bg-teal/15 text-teal-dark"><Check size={12} stroke-width={3} aria-hidden="true" /></span>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <!-- Billed to you directly -->
      <p class="reveal mx-auto mt-8 max-w-2xl text-center text-[13px] font-semibold tracking-[0.08em] text-navy/45 uppercase" style="--d:80ms">Always your own cost, paid directly</p>
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {notes.map((n, i) => (
          <Card class="reveal" style={`--d:${i * 80}ms`}>
            <h3 class="font-display text-base font-semibold text-navy">{n.h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy/65">{n.t}</p>
          </Card>
        ))}
      </div>
      <p class="reveal mt-8 text-center text-sm text-navy/60" style="--d:120ms">
        The full ground rules are in our <a href={withBase('/terms/')} class="font-semibold text-teal-dark underline decoration-teal/40 underline-offset-2 hover:decoration-teal">Terms</a>.
      </p>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="mx-auto max-w-3xl px-[5vw] py-16">
    <p class="reveal text-xs font-semibold tracking-[0.14em] text-teal-dark uppercase">Why publish it at all</p>
    <h2 class="reveal mt-3 font-display text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.15] font-bold text-navy" style="--d:60ms">
      A price you can see is the first proof that the work behind it is real.
    </h2>
    <div class="reveal mt-6 space-y-5 text-[17px] leading-relaxed text-navy/75" style="--d:120ms">
      <p>
        We kept a genuine entry point at ₹16,000 a month on purpose, because a small business that is not yet ready
        for a full engagement still deserves work done properly, not a watered-down version sold as a favour. And we
        kept real depth above it, because a business ready to treat growth as a core function should never have to
        wonder whether its agency is out of its depth.
      </p>
      <p>
        Wherever you start, the promise is the same: the figure you see is the figure we build against, every result is
        reported against the leads and enquiries it generated rather than vanity metrics, and nothing about the arrangement locks you in.
        That is what transparent pricing is for, not a discount, but a signal that there is nothing here we need to
        hide until you are already on a call.
      </p>
    </div>
  </section>

  <script>
    import { CURRENCIES, curatedPrice, detectCurrency, getCurrency, setCurrency, loadRates, formatMoney, onCurrency, usableCurrency } from '../lib/currency.js';

    function initCurrency() {
      const wrap = document.getElementById('cnlCurWrap');
      const btn = document.getElementById('cnlCurBtn');
      const menu = document.getElementById('cnlCurMenu');
      const label = document.getElementById('cnlCurLabel');
      const note = document.getElementById('cnlFxNote');
      if (!wrap || !btn || !menu) return;
      // Guard against double-binding: the inline script runs initCurrency()
      // directly AND on astro:page-load, which fires on first load too. Two
      // click handlers would toggle the menu twice and cancel each other out.
      if (wrap.dataset.curBound) return;
      wrap.dataset.curBound = '1';
      const opts = Array.from(menu.querySelectorAll('li'));
      const chev = btn.querySelector('.cnl-chev');
      // Live rates only matter as a fallback for a currency outside the
      // curated set; curated tiers never wait on them.
      let fx = { rates: null, live: false };

      const shortOf = (cur) => (CURRENCIES[cur] && CURRENCIES[cur].short) || cur;

      const setOpen = (open) => {
        menu.classList.toggle('invisible', !open);
        menu.classList.toggle('opacity-0', !open);
        menu.classList.toggle('-translate-y-1', !open);
        menu.classList.toggle('opacity-100', open);
        menu.classList.toggle('translate-y-0', open);
        btn.setAttribute('aria-expanded', String(open));
        if (chev) chev.classList.toggle('rotate-180', open);
      };

      const apply = () => {
        // The chosen currency is only used if every figure can be shown in it;
        // otherwise the whole page drops to INR rather than mixing symbols.
        const chosen = getCurrency();
        const cur = usableCurrency(chosen);
        if (label) label.textContent = shortOf(cur);
        opts.forEach((o) => o.setAttribute('aria-selected', String(o.getAttribute('data-cur') === cur)));
        document.querySelectorAll('.cnl-price').forEach((el) => {
          const inr = parseInt(el.getAttribute('data-inr'), 10);
          if (Number.isNaN(inr)) return;
          el.textContent = curatedPrice(inr, cur) || formatMoney(inr, cur, fx.rates);
        });
        if (note) {
          if (cur === 'INR') note.textContent = 'In Indian Rupees. Switch if you are elsewhere.';
          else note.textContent = 'Shown in your local currency, billed in INR and confirmed in the written proposal.';
        }
      };

      const cur0 = detectCurrency();
      window.__cnlCur = cur0;
      apply();
      loadRates().then((r) => { fx = r; apply(); });

      btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
      opts.forEach((o) => o.addEventListener('click', () => { setCurrency(o.getAttribute('data-cur')); setOpen(false); }));
      document.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      onCurrency(() => apply());
    }

    initCurrency();
    document.addEventListener('astro:page-load', initCurrency);
  </script>
</Base>
