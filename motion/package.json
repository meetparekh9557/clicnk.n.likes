{
  "name": "clicknlikes-motion",
  "version": "1.0.0",
  "description": "Kinetic typography and UI motion ads for Click.n.likes (Remotion).",
  "main": "index.js",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GrowthAd out/growth-ad.mp4 --browser-executable=$REMOTION_BROWSER --crf=18 --concurrency=4",
    "still": "remotion still src/index.ts GrowthAd out/frame.png --browser-executable=$REMOTION_BROWSER",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "^4.0.514",
    "@remotion/layout-utils": "^4.0.514",
    "@remotion/renderer": "^4.0.514",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.514"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  },
  "private": true
}